#!/usr/bin/env bash
set -uo pipefail

failures=0

ok() { printf 'ok: %s\n' "$1"; }
warn() { printf 'warn: %s\n' "$1"; }
fail() {
	printf 'fail: %s\n' "$1"
	failures=$((failures + 1))
}

show_help() {
	cat <<'EOF'
dotfiles-doctor - run lightweight dotfiles health checks

USAGE:
  dotfiles-doctor [--strict] [repo]
  dotfiles-doctor --help

CHECKS:
  - Makefile entrypoints exist
  - Stow dry-run from repo root
  - Zsh bootstrap and target files exist after linking
  - zsh startup syntax/smoke test
  - Kitty terminfo availability when TERM=xterm-kitty
  - SSH multiplex socket parent exists
  - Git hooks path and delta pager availability
  - Neovim vim.pack availability when nvim is installed
  - Claude agent guard hook is present and loads (settings.json denies every
    tool call if it cannot run, so a broken hook locks the session out)
  - ~/org/agenda exists and is writable (--strict only; warning otherwise)
  - Optional shellcheck and shfmt availability
  - Waybar bluetooth module is listed when configured
EOF
}

# Inside the container sandbox only an allowlist of paths is mounted, so $HOME
# itself is absent and the deployment checks below cannot be answered there: a
# path that was deliberately never bound is not a broken deployment. Report
# those as skipped rather than failed, so `make check` is runnable from inside
# and reports everything it genuinely can measure. Binding the handful of files
# instead would verify three deployed paths while the rest stayed invisible —
# a partial gate that reads as a complete one.
# SANDBOX_ENGINE is set by the launcher for its own boundary. The container
# markers are kept for a foreign container, not for ours: no engine this
# repository drives creates either one any more.
#
# KNOWN GAP, stated rather than papered over: the harness-native boundary
# (bare `claude`, and the editor's ACP door) sets no marker at all and is not
# detectable from inside, so `make check` run there still reports masked paths
# as deployment failures. Run it outside the boundary to get a real answer --
# which is the standing rule for deployment questions anyway, since a mask is
# indistinguishable from a missing file from in here.
sandboxed=0
if [[ -n ${SANDBOX_ENGINE:-} || -e /run/.containerenv || -e /.dockerenv ]]; then
	sandboxed=1
fi
skip() { printf 'skip: %s (%s)\n' "$1" "${2:-not verifiable inside the sandbox}"; }

strict=0
repo=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help)
		show_help
		exit 0
		;;
	--strict)
		strict=1
		;;
	-*)
		printf 'dotfiles-doctor: unknown option: %s\n' "$1" >&2
		exit 2
		;;
	*)
		if [[ -n "$repo" ]]; then
			printf 'dotfiles-doctor: expected at most one repository path\n' >&2
			exit 2
		fi
		repo="$1"
		;;
	esac
	shift
done
repo="${repo:-$PWD}"

if [[ -f "$repo/Makefile" ]] && grep -q '^link:' "$repo/Makefile" && grep -q '^check:' "$repo/Makefile"; then
	ok "Makefile link/check targets"
else
	fail "Makefile link/check targets missing"
fi

# Not [[ -d "$repo/.git" ]]: in a git worktree .git is a FILE, so that test
# reported "repo root not detected" for every worktree. Ask git instead, and
# tell a linked worktree apart from the main checkout -- $HOME is stowed from
# the main checkout, so simulating a worktree over it collides on every tracked
# file and says nothing about the deployment.
repo_git_dir=$(git -C "$repo" rev-parse --git-dir 2>/dev/null || true)
repo_common_git_dir=$(git -C "$repo" rev-parse --git-common-dir 2>/dev/null || true)
if [[ -z "$repo_git_dir" ]]; then
	warn "repo root not detected: $repo"
elif [[ "$repo_git_dir" != "$repo_common_git_dir" ]]; then
	skip "stow dry-run" "linked worktree; the deployment belongs to the main checkout"
else
	if [[ "$sandboxed" -eq 1 ]]; then
		# Masked paths appear INSIDE the repository as /dev/null character
		# devices, so stow reports conflicts over files that do not exist:
		# .profile and .zshrc did on 2026-09-09. The answer in here is wrong,
		# not merely unavailable, which is worse than not asking.
		skip "stow dry-run"
	elif command -v stow >/dev/null 2>&1; then
		stow_output=$(stow --simulate --target="$HOME" --no-folding --dir="$repo" . 2>&1)
		stow_status=$?
		# GNU stow 2.4.2 exits 0 when it aborts on conflicts in simulate mode,
		# so the exit status alone cannot answer this and the message must be
		# read. Keeping it also means a failure says WHICH file collided --
		# discarding it is why a real conflict once reported as a bare "fail".
		if [[ "$stow_status" -eq 0 && "$stow_output" != *"WARNING! "* ]]; then
			ok "stow dry-run"
		else
			fail "stow dry-run"
			printf '%s\n' "$stow_output" | sed 's/^/      /'
		fi
	else
		warn "stow not installed"
	fi
fi

# Only ~/.zshenv is a root stub: it sets ZDOTDIR, after which zsh reads the
# ~/.config/zsh files directly (root .zshrc/.zprofile stubs were removed).
for file in \
	"$HOME/.zshenv" \
	"$HOME/.config/zsh/.zshenv" \
	"$HOME/.config/zsh/.zprofile" \
	"$HOME/.config/zsh/.zshrc" \
	"$HOME/.config/zsh/plugins.zsh"; do
	if [[ -r "$file" ]]; then
		ok "zsh file readable: ${file#$HOME/}"
	elif [[ "$sandboxed" -eq 1 ]]; then
		skip "zsh file: ${file#$HOME/}"
	else
		fail "zsh file missing or unreadable: $file"
	fi
done

if [[ "${TERM:-}" == xterm-kitty ]]; then
	if command -v infocmp >/dev/null 2>&1; then
		if infocmp xterm-kitty >/dev/null 2>&1; then
			ok "xterm-kitty terminfo"
		else
			warn "TERM=xterm-kitty but terminfo missing"
		fi
	else
		warn "TERM=xterm-kitty but infocmp not installed"
	fi
fi

if command -v ssh >/dev/null 2>&1; then
	control_path=$(ssh -G git@github.com 2>/dev/null | awk 'tolower($1) == "controlpath" { print $2; exit }')
	if [[ -n "$control_path" && "$control_path" != none ]]; then
		case "$control_path" in
		~/*) control_path="$HOME/${control_path#~/}" ;;
		/*) ;;
		*) control_path="$HOME/$control_path" ;;
		esac
		control_parent="${control_path%/*}"
		if [[ -d "$control_parent" ]]; then
			ok "ssh ControlPath parent exists: ${control_parent#$HOME/}"
		else
			fail "ssh ControlPath parent missing: $control_parent"
		fi
	else
		warn "ssh ControlPath not configured"
	fi
else
	warn "ssh not installed"
fi

if command -v zsh >/dev/null 2>&1; then
	zsh -i -c exit >/dev/null 2>&1 && ok "zsh startup" || fail "zsh startup"
else
	fail "zsh not installed"
fi

hooks_path=$(git config --get core.hooksPath 2>/dev/null || true)
if [[ "$hooks_path" == "$HOME/.config/git/hooks" || "$hooks_path" == \~/.config/git/hooks ]]; then
	ok "git hooksPath"
else
	warn "git hooksPath is '$hooks_path'"
fi

pager=$(git config --get core.pager 2>/dev/null || true)
if [[ "$pager" == delta ]]; then
	command -v delta >/dev/null 2>&1 && ok "git delta pager" || warn "delta pager configured but delta not installed"
else
	warn "git core.pager is '$pager'"
fi

if command -v nvim >/dev/null 2>&1; then
	nvim --headless +'lua assert(vim.pack)' +qa >/dev/null 2>&1 &&
		ok "nvim vim.pack" || fail "nvim lacks vim.pack"
else
	warn "nvim not installed"
fi

# Agent guard: a bun CLI (.claude/hooks/guardrails.ts) over the shared core in
# ~/.agents/guardrails/ (core.ts + JSON data), used by Claude and pi.
# settings.json's hook command fails CLOSED: when bun is missing or the hook
# cannot load, every matched tool call is denied and the session is unusable
# until it is repaired, so surface the breakage here where it is diagnosable.
# Checks the deployed copies under $HOME, which is what the harness runs.
guard_hook="$HOME/.claude/hooks/guardrails.ts"
if command -v bun >/dev/null 2>&1; then
	if [[ ! -f "$guard_hook" ]]; then
		fail "agent guard hook missing (every tool call denied): ~/.claude/hooks/guardrails.ts"
	elif printf '{}\n' | bun "$guard_hook" >/dev/null 2>&1; then
		ok "agent guard hook loads (bun): guardrails.ts"
	else
		fail "agent guard hook fails to load (every tool call denied): ~/.claude/hooks/guardrails.ts"
	fi
else
	fail "bun missing — Claude agent guard hook denies every tool call"
fi
# Read-only pins whose source lives outside the repository: the sandbox binds a
# path only if it exists, so a relocated toolchain turns a pin into nothing at
# all. Nothing else notices — the profile still lists it and the tests still
# pass, because a fixture creates its own copy.
pins_profile="$repo/.config/sandbox/machinery-ro.profile"
if [[ -r "$pins_profile" ]]; then
	while IFS= read -r pin; do
		pin_path="${pin/#\$H/$HOME}"
		case "$pin_path" in
		"$HOME"/dotfiles/*) continue ;; # covered by check-machinery-ro-sync
		esac
		if [[ -e "$pin_path" ]]; then
			ok "sandbox pin resolves: ${pin_path/#$HOME/\~}"
		else
			warn "sandbox pin has no source, so it binds nothing: ${pin_path/#$HOME/\~}"
		fi
	done < <(awk '/^RO_LAST\+=\(/{f=1;next} f&&/^\)/{f=0} f' "$pins_profile" |
		grep -oE '"\$H/[^"]+"' | tr -d '"')
else
	warn "machinery-ro profile unreadable: $pins_profile"
fi

for asset in core.ts sensitive-paths.json dangerous-commands.json; do
	if [[ -f "$HOME/.agents/guardrails/$asset" ]]; then
		ok "guardrail asset present: $asset"
	else
		fail "guardrail asset missing (hook denies every tool call): ~/.agents/guardrails/$asset"
	fi
done

if [[ -d "$HOME/org/agenda" && -w "$HOME/org/agenda" ]]; then
	ok "$HOME/org/agenda exists and writable"
elif [[ "$strict" -eq 1 ]]; then
	fail "$HOME/org/agenda missing or not writable"
else
	warn "$HOME/org/agenda missing or not writable"
fi

# warn, not fail: these are Wayland-desktop deps, and make test asserts a zero
# doctor exit from a temp home — a headless host is not a broken deployment.
for cmd in grim slurp wl-copy; do
	if command -v "$cmd" >/dev/null 2>&1; then
		ok "screenshot dependency installed: $cmd"
	else
		warn "screenshot dependency missing: $cmd"
	fi
done

if command -v shellcheck >/dev/null 2>&1; then
	ok "shellcheck installed"
else
	warn "shellcheck not installed"
fi

if command -v shfmt >/dev/null 2>&1; then
	ok "shfmt installed"
else
	warn "shfmt not installed"
fi

waybar_config="$repo/.config/waybar/config"
if [[ -f "$waybar_config" ]]; then
	if grep -q '"bluetooth"' "$waybar_config"; then
		ok "waybar bluetooth module present"
	else
		warn "waybar bluetooth config exists but module not listed"
	fi
fi

# cron never reads the repository copy -- it must be loaded by hand with
# `crontab ~/.local/cron` -- so the live crontab and the tracked file drift in
# silence. That is how the OneDrive sync came to be commented out in the live
# crontab and absent from the tracked one, running nowhere and recorded nowhere.
cron_file="$repo/.local/cron"
if [[ ! -r "$cron_file" ]]; then
	warn "tracked crontab unreadable: $cron_file"
elif ! command -v crontab >/dev/null 2>&1; then
	warn "crontab not installed"
elif [[ "$sandboxed" -eq 1 ]]; then
	skip "live crontab matches the tracked copy"
else
	live_cron=$(crontab -l 2>/dev/null || true)
	if [[ -z "$live_cron" ]]; then
		warn "no crontab loaded, so no tracked entry is scheduled: crontab $cron_file"
	else
		cron_drift=0
		while IFS= read -r entry; do
			[[ -z "$entry" ]] && continue
			printf '%s\n' "$live_cron" | grep -qxF "$entry" && continue
			fail "tracked cron entry is not scheduled: ${entry:0:70}"
			cron_drift=1
		done < <(grep -vE '^[[:space:]]*(#|$)' "$cron_file" || true)
		while IFS= read -r entry; do
			[[ -z "$entry" ]] && continue
			grep -qxF "$entry" "$cron_file" && continue
			warn "live cron entry is not tracked: ${entry:0:70}"
			cron_drift=1
		done < <(printf '%s\n' "$live_cron" | grep -vE '^[[:space:]]*(#|$)' || true)
		[[ "$cron_drift" -eq 0 ]] && ok "live crontab matches the tracked copy"
	fi
fi

# GDM reads system session directories only, so this file cannot live in the
# repository, and reinstalling mango can silently restore `Exec=mango` -- which
# starts the compositor with the bare system PATH and none of XDG_DATA_HOME,
# GNUPGHOME or PASSWORD_STORE_DIR. warn, not fail: repairing it needs root, and
# a headless host has no session entry at all.
session_entry=/usr/share/wayland-sessions/mango.desktop
if [[ -r "$session_entry" ]]; then
	if grep -qE '^Exec=.*mango-session' "$session_entry"; then
		ok "desktop session runs through mango-session"
	else
		warn "desktop session bypasses mango-session, so it starts with the bare system PATH; repair: sudo sed -i 's|^Exec=.*|Exec=$HOME/.local/scripts/mango-session|' $session_entry"
	fi
fi

# `mango -p` parses the config and names every keyword it rejected, but exits 0
# whatever it finds, so its OUTPUT is the only signal -- three input.conf lines
# were being skipped for a year this way. It resolves the `source=~/...` lines
# against $HOME, so this reads the deployed copies.
mango_config="$HOME/.config/mango/config.conf"
if ! command -v mango >/dev/null 2>&1; then
	: # not this host's compositor; the Wayland warnings above already say so
elif [[ "$sandboxed" -eq 1 ]]; then
	skip "mango config parses"
elif [[ ! -r "$mango_config" ]]; then
	warn "mango installed but no config at ${mango_config/#$HOME/\~}"
else
	# Unanchored on purpose: mango writes colour escapes before the tag, so
	# "^\[ERROR\]" matches nothing and the check silently cannot fail.
	mango_errors=$(mango -c "$mango_config" -p 2>&1 | grep -c '\[ERROR\]' || true)
	if [[ "$mango_errors" -gt 0 ]]; then
		fail "mango rejected $mango_errors config line(s); see: mango -c ${mango_config/#$HOME/\~} -p"
	else
		ok "mango config parses"
	fi
fi

exit "$failures"
