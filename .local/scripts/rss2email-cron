#!/bin/bash

set -euo pipefail

# Reads the primary address from pass, derives the +rss alias, renders the
# tracked config's placeholders into a temporary file, and runs r2e on it.
R2E_BIN="$HOME/.local/bin/r2e"
RSS2EMAIL_CONFIG="$HOME/.config/rss2email.cfg"
PRIMARY_EMAIL_ENTRY="primary-gmail"
RSS_EMAIL_SUFFIX="rss"
IMAP_PASSWORD_ENTRY="primary-gmail-secret"
# msmtp (pkgit-built) sends via the tracked ~/.config/msmtp/config; the
# system /usr/sbin/sendmail has no configured MTA behind it on this host.
RSS2EMAIL_SENDMAIL="$HOME/.local/bin/msmtp"

if [[ ! -x "$R2E_BIN" ]]; then
	echo "rss2email-cron: r2e binary not executable: $R2E_BIN" >&2
	exit 1
fi

if [[ ! -f "$RSS2EMAIL_CONFIG" ]]; then
	echo "rss2email-cron: config not found: $RSS2EMAIL_CONFIG" >&2
	exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

primary=$(pass show "$PRIMARY_EMAIL_ENTRY" | sed -n '1p')
imap_password=$(pass show "$IMAP_PASSWORD_ENTRY" | sed -n '1p')

rss=$(printf '%s\n' "$primary" | sed "s/@/+${RSS_EMAIL_SUFFIX}@/")

sed \
	-e "s|__RSS2EMAIL_PRIMARY_EMAIL__|$primary|g" \
	-e "s|__RSS2EMAIL_RSS_EMAIL__|$rss|g" \
	-e "s|__RSS2EMAIL_SENDMAIL__|$RSS2EMAIL_SENDMAIL|g" \
	-e "s|__RSS2EMAIL_IMAP_PASSWORD__|$imap_password|g" \
	"$RSS2EMAIL_CONFIG" >"$tmp"

if [[ $# -eq 0 ]]; then
	set -- run
fi

exec "$R2E_BIN" --config "$tmp" "$@"
