#!/usr/bin/env bash
# hpc: push the current branch (to `origin`, e.g. GitHub), sync it onto a
# cluster working copy over SSH, and run a command there fully detached from
# the SSH connection (survives SSH/laptop disconnect -- needed because a
# blocking `--multirun` Slurm-launcher process polls job.result() until every
# submitted task finishes).
#
# Usage:
#   hpc [--dirty] [--host <alias>] [--remote <name>] [--dir <path>] [--runs-dir <path>] [--name <name>] <command...>
#
# Assumes `<remote>` (default: origin) is a normal git remote this laptop
# pushes to and the cluster independently fetches/checks out from -- either a
# hosted remote like GitHub, or a bare repo living on the cluster itself (e.g.
# `--remote triton` for a project set up like bed-d-sep). Either way, the
# cluster-side working copy fetches from ITS OWN "origin" remote (whatever it
# was cloned with) -- that's independent of what this laptop calls its remote,
# so it's not configurable here. The cluster side just needs a one-time
# `git clone <remote-url>` already done at the path this script targets (see
# --dir / HPC_DIR below).
#
# No cluster hostname is hardcoded here (this file is meant to be safe to
# publish, e.g. in a public dotfiles repo) -- pass --host, or set HPC_HOST in
# your own (private) shell rc, once per cluster you use.
#
# <command> runs backgrounded on the remote (nohup + setsid, stdin/stdout/
# stderr detached from the ssh channel), NOT in tmux -- there's nothing here
# that ever needs interactive re-attach, and per-run files are a plainer unit
# of compartmentalization than tmux sessions/windows once you're running many
# experiments across many projects at once. Per run, under
# <project>/results/hpc/<name>.{log,pid,exit} on the remote by default:
#   .log   combined stdout+stderr of <command>
#   .pid   pid of the backgrounded process
#   .exit  written once `timeout` returns (exit code) -- absence means still
#          running, never started, or the driver was killed; this is the full completion signal,
#          there's no pane to peek at instead.
#   .copy  physical path of the working copy that launched the run. The live-run guard
#          counts a run against the copy it belongs to (listed in <copy>/.git/hpc-runs),
#          whatever runs dir it writes to, and never against another copy sharing that dir.
# <command> itself runs under `timeout $HPC_TIMEOUT` so .exit is guaranteed to
# eventually be written even for a hung command.
#
# If a `.env` file exists at the root of the target directory, it is sourced
# (`set -a; . .env`, in a subshell) and its UPPERCASE keys other than HPC_CODE are
# exported into <command>'s environment before it runs; any other key it sets is
# skipped with a warning -- this is the mechanism for project-scoped
# secrets (API keys, DB creds, etc.) that shouldn't live in a committed
# launcher config. Deliberately plain-file, not direnv: ssh command execution
# is a non-interactive, non-login shell, so direnv's shell-prompt hook never
# fires, and `direnv exec`/`direnv allow` have their own sharp edges when the
# target dir is reached through a symlink (e.g. a small-quota $HOME symlinked
# into bulk scratch storage, common on HPC clusters) -- sourcing a plain file
# sidesteps both problems. `.env` is expected to be gitignored; this script
# does not create, template, or manage its contents.
#
# Why nohup+setsid+redirect, not just "cmd &": setsid detaches the job into a
# brand-new session with no controlling terminal, so when the ssh connection
# drops there's no session for sshd to deliver SIGHUP to -- that's what makes
# the job survive closing your laptop or killing the local ssh client, not the
# redirect. The redirect (< /dev/null > log 2>&1) is what lets the *local*
# `ssh` invocation end with the remote script, after its queue check, instead of
# hanging for the whole run: a backgrounded child
# keeps its own copy of the parent shell's stdout/stderr fd (fork() duplicates
# fds), so that pipe never reaches EOF -- and ssh waits for EOF, not just for
# the top-level remote command to exit -- until every process holding a copy
# closes it. nohup (ignore SIGHUP if somehow delivered anyway) and disown
# (stop the remote shell itself from signaling the job on exit) are belt-and-
# suspenders on top of setsid, not the primary mechanism.
#
# Why there is no CPU-time ceiling on <command>: a `ulimit -t` on the remote
# payload looks like a cheap guard against someone handing this script real
# computation instead of a submit-and-poll driver (the driver burns ~no CPU on
# the login node, a computation blows through any ceiling immediately). It is
# not. Slurm captures the submitting process's resource limits and propagates
# them to the job it creates (PropagateResourceLimits, ALL by default), so the
# ceiling would ride through `sbatch` onto the compute node and kill the real
# job -- and rlimits are per-process, so an N-thread job burns an hour's budget
# in 3600/N seconds of wall clock. Do not add one back: keeping heavy work off
# the login node is discipline, not something this wrapper can enforce.
#
# Frozen-code mode (opt-in per cluster working copy). A Slurm task reads code from
# the working copy when it STARTS, possibly days after submission, so in the default
# mode this script must refuse to move the working copy while any run it launched is
# alive -- one long sweep then blocks every new launch in that project. In frozen-code
# mode the working copy is never reset. Instead each launched commit gets its own
# git worktree, <dir>/.hpc/wt/<sha>, created once and never modified, and the command
# runs with $HPC_CODE pointing at it while its cwd stays <dir>, so outputs
# (results/ etc.) land where they always did. The shared working copy holds NO
# committed files (a sparse checkout of nothing), so a program that opens a committed
# file by a cwd-relative path fails with file-not-found instead of reading a stale
# copy; this script refuses to launch if committed files reappear there. Two cwd reads
# that do NOT fail loudly: `git rev-parse HEAD` reports the shared copy's HEAD, not the
# run's commit (read <runs-dir>/<name>.sha, or run git in the code's directory), and an
# uncommitted input placed in <dir> by hand can still change under pending tasks.
# A project points its tooling at $HPC_CODE through the working copy's .env. For uv:
#   UV_PROJECT=$HPC_CODE   # uv run uses the worktree's project, so its venv is
#                          # <worktree>/.venv (or <worktree>/$UV_PROJECT_ENVIRONMENT when
#                          # that is relative): one venv per commit, created on first use
#   UV_FROZEN=1            # never rewrite uv.lock inside a worktree
#   UV_CACHE_DIR=<path on the same filesystem as <dir>>   # hardlink, not copy, packages
# UV_PROJECT_ENVIRONMENT must stay RELATIVE (e.g. .venv-aarch64 for a per-arch venv): an
# absolute one is a single venv shared by every commit, whose editable install is rewritten
# to point at the last-synced worktree, so a pending task of commit A would import commit
# B. This script refuses that combination. In default mode $HPC_CODE is <dir> itself, so
# these lines are harmless there.
# Enable once, on the cluster, when NO Slurm task of any run launched from <dir> is
# pending or running (they read <dir>, which enabling empties):
#   cd <dir> && mkdir -p .hpc && touch .hpc/frozen-code
#   git sparse-checkout set --no-cone '/.hpc-no-tracked-files'
# Worktrees (source tree + venv per launched commit) are never removed automatically.
# <runs-dir>/<name>.sha names each run's commit; once no run or pending task uses a
# commit: git -C <dir> worktree remove --force <dir>/.hpc/wt/<sha>
#
# CLI / env config (CLI wins if both given):
#   --host <alias> / HPC_HOST   ssh alias/host to run on. Use a *pinned* login
#                node from your ~/.ssh/config, not a round-robin hostname: a
#                background job's files live under whatever $HOME that node
#                resolves to, so a fixed alias is what makes "check on it
#                later" actually work.
#   --remote <name> / HPC_REMOTE   git remote this laptop pushes to (default: origin)
#   --dir <path> / HPC_DIR   remote path to the project's working copy,
#                relative to the remote $HOME unless it starts with "/"
#                (default: projects/<local-repo-dirname>) -- override this
#                whenever the local dir, remote dir, and git host repo name
#                don't all match, since nothing here can infer that for you.
#   --runs-dir <path> / HPC_RUNS_DIR   remote directory for this wrapper's
#                .log/.pid/.exit files. Relative paths are resolved under the
#                project working copy (default: results/hpc, so normal
#                project-results rsync pulls these logs too); absolute paths
#                and ~/ paths are resolved as remote user paths.
#   --name <name> / HPC_NAME   run name, used for the log/pid/exit filenames
#                (default: <reponame>-<timestamp>, unique per invocation so
#                concurrent runs of the same repo never collide). A name works
#                once per runs dir: hpc refuses it while that run is live and
#                after it has ended.
#   HPC_SSH      ssh command (default: ssh); the test harness sets a local stand-in.
#   HPC_TIMEOUT  hard ceiling on <command> itself, passed to `timeout` on the
#                remote (default: 7d) -- bump this per-invocation for jobs you
#                know will run longer than a week; a Slurm --time limit on the
#                job itself should still be the primary bound, this is just
#                the backstop that guarantees .exit always eventually gets
#                written.
set -euo pipefail

allow_dirty=false
host_override=""
remote_override=""
dir_override=""
runs_dir_override=""
name_override=""
usage='usage: hpc [--dirty] [--host <alias>] [--remote <name>] [--dir <path>] [--runs-dir <path>] [--name <name>] [--] <command...>'
while [[ $# -gt 0 ]]; do
	case "$1" in
	--dirty)
		allow_dirty=true
		shift
		;;
	--host)
		host_override="$2"
		shift 2
		;;
	--host=*)
		host_override="${1#--host=}"
		shift
		;;
	--remote)
		remote_override="$2"
		shift 2
		;;
	--remote=*)
		remote_override="${1#--remote=}"
		shift
		;;
	--dir)
		dir_override="$2"
		shift 2
		;;
	--dir=*)
		dir_override="${1#--dir=}"
		shift
		;;
	--runs-dir)
		runs_dir_override="$2"
		shift 2
		;;
	--runs-dir=*)
		runs_dir_override="${1#--runs-dir=}"
		shift
		;;
	--name)
		name_override="$2"
		shift 2
		;;
	--name=*)
		name_override="${1#--name=}"
		shift
		;;
	--)
		shift
		break
		;;
	-h | --help)
		echo "$usage"
		exit 0
		;;
	-*)
		# Falling through would push the branch and run the mistyped flag as a
		# command on the cluster. A command that does start with a dash goes after --.
		printf 'hpc: unknown option %s\n%s\n' "$1" "$usage" >&2
		exit 1
		;;
	*) break ;;
	esac
done
if [[ $# -eq 0 ]]; then
	echo "$usage" >&2
	exit 1
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	echo "hpc: not inside a git repo" >&2
	exit 1
}
reponame=$(basename "$repo_root")
branch=$(git -C "$repo_root" rev-parse --abbrev-ref HEAD)
# The exact commit this launch means. Passed to the remote so it can prove it
# ended up on OUR code rather than on whatever its own origin happened to hold.
want_sha=$(git -C "$repo_root" rev-parse HEAD)

if [[ "$allow_dirty" == false ]] && [[ -n $(git -C "$repo_root" status --porcelain --untracked-files=no) ]]; then
	echo "hpc: working tree has uncommitted changes to tracked files -- commit them first, or pass --dirty to push only what's already committed (the remote will still refuse to run anything not pushed)." >&2
	exit 1
fi

remote="${remote_override:-${HPC_REMOTE:-origin}}"
git -C "$repo_root" remote get-url "$remote" >/dev/null 2>&1 || {
	echo "hpc: no '$remote' remote in $repo_root -- set one up first (e.g. GitHub, or a bare repo on the cluster)." >&2
	exit 1
}

host="${host_override:-${HPC_HOST:-}}"
if [[ -z "$host" ]]; then
	echo "hpc: no host specified -- pass --host <alias> or set HPC_HOST (e.g. a ~/.ssh/config entry for a pinned login node)." >&2
	exit 1
fi
dir="${dir_override:-${HPC_DIR:-projects/$reponame}}"
runs_dir="${runs_dir_override:-${HPC_RUNS_DIR:-results/hpc}}"
name="${name_override:-${HPC_NAME:-$reponame-$(date +%Y%m%d-%H%M%S)}}"
timeout_dur="${HPC_TIMEOUT:-7d}"
cmd=$(printf '%q ' "$@")

echo "hpc: pushing $branch -> $remote" >&2
git -C "$repo_root" push -u "$remote" "$branch"

disp_dir="$dir"
# shellcheck disable=SC2088  # display string for the remote path, not expanded locally
[[ "$dir" == /* ]] || disp_dir="~/$dir"
echo "hpc: syncing $reponame@$branch into $disp_dir on $host, launching '$name' (timeout $timeout_dur)" >&2

# ssh does NOT preserve argv boundaries for a remote command: it joins every
# argument after the hostname with a single space and hands that one string
# to the remote shell to reparse. Passing dir/branch/name/cmd/timeout as
# separate argv elements (even individually double-quoted *locally*) would
# therefore get re-split on whitespace remotely -- silently truncating
# anything in $cmd after its first word. Fix: pre-quote each piece with %q
# ourselves and hand ssh a single already-remote-shell-safe string.
remote_argv=$(printf '%q %q %q %q %q %q %q' "$dir" "$branch" "$runs_dir" "$name" "$cmd" "$timeout_dur" "$want_sha")
"${HPC_SSH:-ssh}" "$host" "bash -s -- $remote_argv" <<'REMOTE'
set -euo pipefail
dir=$1; branch=$2; runs_dir=$3; name=$4; cmd=$5; timeout_dur=$6; want_sha=$7
case "$dir" in
  /*) target="$dir" ;;
  *) target="$HOME/$dir" ;;
esac

# Before the mkdir below, which would create $target for a relative runs directory.
cd "$target" 2>/dev/null || {
  echo "hpc: $target does not exist on $(hostname) -- clone the repo there first (git clone <origin-url> $target)." >&2
  exit 1
}

case "$runs_dir" in
  /*) runs="$runs_dir" ;;
  \~ | \~/*) runs="$HOME${runs_dir#\~}" ;;
  *) runs="$target/$runs_dir" ;;
esac
mkdir -p "$runs"
# One launch at a time per working copy: concurrent `git fetch` in one repo fails on a ref
# lock, two launches of a new commit would race to create its worktree, and the live-run
# guard below is only sound if no other launch can move the tree between its check and the
# new run's registration. The lock file sits in the copy's git dir, so it is one file however
# <dir> is spelled (a symlinked $HOME reaches one copy by two paths), and copies that share a
# runs dir do not wait on each other. It is held until the run's pidfile exists -- a launch
# that found the lock free but no pidfile could move the tree under a run already started --
# and the run itself does not inherit it.
# A filesystem mounted without flock support (some Lustre mounts) returns ENOSYS; that must
# not block every launch, so fall back to unserialized launches with a warning.
gitdir=$(git rev-parse --absolute-git-dir)
exec 9>"$gitdir/hpc-launch.lock"
flock 9 || echo "hpc: warning: cannot lock $gitdir/hpc-launch.lock on this filesystem; launching unserialized." >&2
pidfile="$runs/$name.pid"; logfile="$runs/$name.log"; exitfile="$runs/$name.exit"
# The runs of this working copy, whatever runs dir each writes to: <git dir>/hpc-runs lists
# their pidfiles. A pidfile in this runs dir without a .copy marker comes from a launch made
# before the list existed, so it counts too; a marked one belongs to the copy it names.
registry="$gitdir/hpc-runs"
live_runs() { # pidfiles of this copy's runs whose driver is alive on this node
  local p
  {
    [[ ! -f "$registry" ]] || cat "$registry"
    for p in "$runs"/*.pid; do
      [[ -e "${p%.pid}.copy" ]] || printf '%s\n' "$p"
    done
  } | sort -u | while IFS= read -r p; do
    if [[ -f "$p" && ! -e "${p%.pid}.exit" ]] && kill -0 "$(cat "$p")" 2>/dev/null; then
      printf '%s\n' "$p"
    fi
  done
}

if [[ -f "$pidfile" && ! -e "$exitfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
  echo "hpc: run '$name' already in progress (pid $(cat "$pidfile")) -- tail $logfile, or pick a different --name." >&2
  exit 1
fi
# A finished run under this name would be erased: the log is truncated below and the
# exit file overwritten, and nothing in results/<tag>/ would say that two launches wrote it
# (causal-benchmark LOG 2026-10-29: a relaunch appended into the morning launch's files).
# A killed driver writes no exit file, so its pid file counts too: a driver live
# on this node already returned above.
if [[ -e "$exitfile" || -e "$pidfile" ]]; then
  echo "hpc: run '$name' already finished (exit $(cat "$exitfile" 2>/dev/null || echo "unknown: no live driver on this node, so it was killed or runs on another"), log $logfile) -- pick a different --name, and a different output directory if that run wrote one." >&2
  exit 1
fi

git fetch origin

# This working copy fetches from ITS OWN origin, which the header assumes is the
# same repo the laptop pushed to but nothing has ever checked. When it is not,
# the checkout below fails in a way that reads like a bad branch name.
if ! git rev-parse --verify --quiet "origin/$branch^{commit}" >/dev/null; then
  echo "hpc: origin/$branch does not exist at $target on $(hostname) even after fetching -- this working copy's 'origin' is not the remote the laptop pushed to. Check 'git -C $target remote -v'." >&2
  exit 1
fi

if [[ -f "$target/.hpc/frozen-code" ]]; then
  present="$(git ls-files -t)" || {
    echo "hpc: cannot verify $target's frozen-code checkout (git ls-files failed); refusing to launch." >&2
    exit 1
  }
  if [[ -n "$present" ]] && grep -qv '^S ' <<<"$present"; then
    echo "hpc: $target is in frozen-code mode but has committed files checked out, so cwd-relative reads would silently get stale copies. Restore with: git -C $target sparse-checkout set --no-cone '/.hpc-no-tracked-files'" >&2
    exit 1
  fi
  if [[ "$(git rev-parse "origin/$branch")" != "$want_sha" ]]; then
    echo "hpc: origin/$branch at $target is $(git rev-parse "origin/$branch") but the laptop pushed $want_sha -- stale mirror or a different repo. Not launching." >&2
    exit 1
  fi
  wt="$target/.hpc/wt/$want_sha"
  mkdir -p "$target/.hpc/wt"
  if [[ ! -e "$wt/.git" ]]; then
    # A new worktree inherits the shared copy's empty sparse checkout; turn it off there.
    git worktree add -q --detach "$wt" "$want_sha"
    git -C "$wt" sparse-checkout disable
  fi
  if [[ "$(git -C "$wt" rev-parse HEAD)" != "$want_sha" ]] || git -C "$wt" ls-files -t | grep '^S ' >/dev/null; then
    echo "hpc: worktree $wt is not a full checkout of $want_sha -- remove it (git -C $target worktree remove --force $wt) and relaunch." >&2
    exit 1
  fi
  code_dir="$wt"
else
  if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
    echo "hpc: working copy at $target has uncommitted changes to tracked files -- refusing to reset. Inspect manually." >&2
    exit 1
  fi

  # A running job reads this working copy for its whole life (days, for a blocking
  # --multirun driver that keeps submitting tasks), so resetting it mid-flight
  # makes every task starting afterwards load different code: one results tag, two
  # versions, no record anywhere. Only a reset that MOVES the commit can do that,
  # so relaunching the SAME commit with a different seed/config still goes through
  # -- that no-op case is the common one and must not be blocked. HEAD here is
  # still the live run's commit, because nothing has moved the tree yet.
  # One limit, deliberate: this sees only runs launched by this script and still
  # tracked by a live pidfile (a hand-submitted job is invisible).
  # A clone whose remote HEAD names a missing branch has an unborn HEAD: no commit
  # is checked out, so no run can be reading this tree and there is nothing to guard.
  cur_sha=$(git rev-parse --verify --quiet HEAD) || cur_sha=""
  if [[ -n "$cur_sha" && "$cur_sha" != "$want_sha" ]]; then
    live=$(live_runs)
    if [[ -n "$live" ]]; then
      p=${live%%$'\n'*}
      echo "hpc: run '$(basename "$p" .pid)' is still running here (pid $(cat "$p")), and this launch would move $target from $cur_sha to $want_sha underneath it." >&2
      echo "hpc: wait for it to finish, or launch into a separate working copy with --dir." >&2
      exit 1
    fi
  fi

  # The dirty check above cannot see committed-but-unpushed work: committing here
  # leaves the tree clean, so the checkout below would drop those commits with no
  # warning and reflog-only recovery. It reads the local branch by name, so it
  # needs no checkout first.
  if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null &&
    [[ -n $(git rev-list "origin/$branch..refs/heads/$branch") ]]; then
    echo "hpc: the working copy at $target has commits on $branch that are not in origin/$branch:" >&2
    git log --oneline "origin/$branch..refs/heads/$branch" >&2
    echo "hpc: refusing to reset -- push or drop them there, then retry." >&2
    exit 1
  fi

  # Nothing above guarantees origin/$branch is the commit the laptop just pushed:
  # a stale mirror, a different repo, or someone pushing over the branch in the
  # seconds between the push and the fetch would all leave this copy on other
  # code -- and then the job runs, the logs look normal, and the results silently
  # belong to a commit nobody chose.
  origin_sha=$(git rev-parse "origin/$branch")
  if [[ "$origin_sha" != "$want_sha" ]]; then
    echo "hpc: origin/$branch at $target is $origin_sha but the laptop pushed $want_sha -- this working copy's 'origin' is a stale mirror or a different repo. Not launching." >&2
    exit 1
  fi

  # Every check that can refuse runs above this line, so a refused launch leaves
  # the tree where a live run left it. One step from the current commit to the
  # pushed one: checking out a stale local branch first would put its old tree
  # under a live run in between. The target is the pushed commit itself, not
  # origin/$branch, which a concurrent fetch could move after the check above.
  git checkout -q -B "$branch" "$want_sha"
  # The upstream is a convenience for whoever works in this copy, and nothing here
  # reads it. Git refuses it under some fetch refspecs, and failing on that would
  # stop every launch of the branch after the tree has already moved.
  git rev-parse --verify --quiet "$branch@{upstream}" >/dev/null ||
    git branch -q --set-upstream-to="origin/$branch" "$branch" 2>/dev/null || true
  code_dir="$target"
fi

# The code this run must use; a project maps it onto its tooling in .env (UV_PROJECT=$HPC_CODE).
export HPC_CODE="$code_dir"
# Source .env into THIS shell rather than composing it into the launched command string.
# `timeout` can only exec binaries, so a chain beginning with the `set` builtin made it fail
# with 127 before anything ran -- and because that only happens when a project HAS a .env,
# the path shipped unexercised. nohup/setsid inherit the environment, so <command> sees the
# variables just the same, with one less layer of quoting. A failing .env aborts the launch
# loudly instead of writing an exit file.
# .env is sourced in a subshell and only UPPERCASE keys other than HPC_CODE come back: this
# script's own variables are lowercase, and a project .env saying `name=...` used to rename
# the run's records (and `cmd=...` could replace the command). Skipped keys are named.
if [[ -f "$target/.env" ]]; then
  env_vars=$(
    set -ea
    . "$target/.env"
    set +a
    for k in $(compgen -e); do printf '%s %q\n' "$k" "${!k}"; done
  )
  skipped="" v=""
  while read -r k qv; do
    [[ -n "$k" ]] || continue
    eval "v=$qv"
    if [[ "$k" =~ ^[A-Z][A-Z0-9_]*$ && "$k" != HPC_CODE ]]; then
      export "$k=$v"
    elif [[ "${!k-}" != "$v" ]]; then
      skipped+=" $k"
    fi
  done <<<"$env_vars"
  [[ -z "$skipped" ]] || echo "hpc: warning: $target/.env sets$skipped, not imported: only UPPERCASE keys other than HPC_CODE reach <command>." >&2
fi
# See the header: an absolute uv environment outside the worktree is shared by every commit.
if [[ "$code_dir" != "$target" && "${UV_PROJECT_ENVIRONMENT:-}" == /* && "$UV_PROJECT_ENVIRONMENT" != "$code_dir"/* ]]; then
  echo "hpc: UV_PROJECT_ENVIRONMENT=$UV_PROJECT_ENVIRONMENT is absolute, so every frozen commit would share one venv (and one editable install). Make it relative, e.g. .venv-$(uname -m). Not launching." >&2
  exit 1
fi
# Register the run with this copy before it starts. The .copy marker tells another copy
# sharing this runs dir that the run is not its own; ended runs drop out of the list here.
pwd -P > "$runs/$name.copy"
{ live_runs; printf '%s\n' "$pidfile"; } > "$registry.new"
mv "$registry.new" "$registry"
echo "$want_sha" > "$runs/$name.sha"
nohup setsid bash -c "timeout $timeout_dur $cmd; echo \$? > '$exitfile'" \
  < /dev/null > "$logfile" 2>&1 9>&- &
echo $! > "$pidfile"
exec 9>&-
disown
echo "hpc: launched (pid $(cat "$pidfile"))."
# A hint that the driver reached the scheduler: show the queue once, every job of this
# user. A driver that dies before sbatch, or an array that never queues, is otherwise
# found a day later from the log.
sleep 45
echo "hpc: your whole queue after 45 s, not only this run (empty = nothing submitted yet, or already failed: read $logfile):"
squeue --me --format='%.12i %.9P %.24j %.2t %.10M %.6D %R' 2>/dev/null || echo "hpc: squeue unavailable on $(hostname)"
REMOTE

case "$runs_dir" in
/* | \~ | \~/*) display_runs="$runs_dir" ;;
*) display_runs="$disp_dir/$runs_dir" ;;
esac
echo "hpc: log    : ssh $host tail -f $display_runs/$name.log"
echo "hpc: status : ssh $host \"kill -0 \\\$(cat $display_runs/$name.pid) 2>/dev/null && echo running || echo done\""
echo "hpc: squeue : ssh $host squeue -u \$USER"
