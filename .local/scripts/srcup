#!/usr/bin/env bash
set -euo pipefail

: "${XDG_CONFIG_HOME:=$HOME/.config}"
SCRIPT_DIR="$XDG_CONFIG_HOME/srcup"

show_help() {
	cat <<'EOF'
srcup - run source-update helper for current repo or named package

USAGE:
  srcup [package]
  srcup --help

DESCRIPTION:
  Without an argument, detects the current Git repository name and runs the
  matching helper from ~/.config/srcup/<repo>.sh.

  With a package argument, verifies ./<package> exists in the current
  directory, then runs ~/.config/srcup/<package>.sh from that package dir.

  Typical source workspace use:
    cd ~/.local/src
    srcup neovim

  Executable helpers are executed directly. Readable non-executable helpers
  are refused; make helpers executable before running them.
EOF
}

validate_package() {
	local package="$1"

	if [[ ! "$package" =~ ^[A-Za-z0-9._-]+$ ]]; then
		echo "srcup: invalid package name: $package" >&2
		echo "allowed: letters, numbers, dot, underscore, dash" >&2
		exit 2
	fi
}

update_source_checkout() {
	git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

	local git_dir branch upstream remote remote_branch
	git_dir=$(git rev-parse --git-dir)

	if [[ -e "$git_dir/MERGE_HEAD" || -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" || -e "$git_dir/CHERRY_PICK_HEAD" ]]; then
		echo "srcup: refusing to update: git operation already in progress" >&2
		exit 1
	fi

	if ! git diff --quiet || ! git diff --cached --quiet; then
		echo "srcup: refusing to update: worktree has local changes" >&2
		exit 1
	fi

	branch=$(git symbolic-ref --quiet --short HEAD) || {
		echo "srcup: refusing to update: detached HEAD" >&2
		exit 1
	}

	if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
		remote=${upstream%%/*}
		remote_branch=${upstream#*/}
	else
		remote=origin
		remote_branch=$branch
	fi

	git fetch --no-tags --prune "$remote" "$remote_branch"

	if ! git diff --quiet || ! git diff --cached --quiet; then
		echo "srcup: refusing to update: fetch changed local worktree unexpectedly" >&2
		exit 1
	fi

	if git merge-base --is-ancestor HEAD FETCH_HEAD; then
		git merge --ff-only FETCH_HEAD
	elif git merge-base --is-ancestor FETCH_HEAD HEAD; then
		printf 'srcup: local branch is ahead of %s/%s; leaving it unchanged\n' "$remote" "$remote_branch" >&2
	else
		printf 'srcup: upstream diverged; resetting clean source checkout to %s/%s\n' "$remote" "$remote_branch" >&2
		git reset --hard FETCH_HEAD
	fi
}

run_script() {
	local script="$1"

	if [[ ! -e "$script" ]]; then
		echo "srcup: no script found" >&2
		echo "expected: $script" >&2
		exit 1
	fi
	if [[ -x "$script" ]]; then
		exec "$script"
	fi
	if [[ -r "$script" ]]; then
		echo "srcup: refusing to run non-executable script: $script" >&2
		echo "srcup: make it executable with: chmod +x $script" >&2
		exit 1
	fi

	echo "srcup: script is not readable: $script" >&2
	exit 1
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
	show_help
	exit 0
fi

if [[ "$#" -gt 1 ]]; then
	echo "usage: srcup [package]" >&2
	exit 1
fi

if [[ "$#" -eq 1 ]]; then
	package="$1"
	validate_package "$package"

	package_dir="./$package"
	package_dir_real=$(realpath "$package_dir" 2>/dev/null) || {
		echo "srcup: package dir not found for '$package'" >&2
		echo "expected: $PWD/$package" >&2
		exit 1
	}

	if [[ ! -d "$package_dir_real" ]]; then
		echo "srcup: package path is not a directory: $package_dir_real" >&2
		exit 1
	fi

	script="$SCRIPT_DIR/$package.sh"

	cd "$package_dir_real"
	update_source_checkout
	run_script "$script"
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
	echo "srcup: not inside a git repository" >&2
	echo "tip: use 'srcup <package>' from a directory containing ./<package>" >&2
	exit 1
}

repo=$(basename "$root")
validate_package "$repo"
script="$SCRIPT_DIR/$repo.sh"

cd "$root"
update_source_checkout
run_script "$script"
