#!/bin/bash

set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
inject-template - example wrapper for injecting pass secrets into a command

USAGE:
  inject-template --help

DESCRIPTION:
  Template only. Copy this file, replace `your_exec` and pass entry names,
  then make the copy executable.
EOF
    exit 0
fi

echo "inject-template: template only; copy and customize before use" >&2
exit 1

# Assumes $HOME/.local/scripts comes first in PATH.
REAL_EXEC=$(which -a your_exec | grep -v "$(which your_exec)" | head -1)

{ [ -z "$REAL_EXEC" ] || [ ! -x "$REAL_EXEC" ]; } && { echo "your_exec: command not found" >&2; exit 127; }

USERNAME_VALUE="user"
API_KEY_VALUE="$(pass show apikey)"

exec env \
    USERNAME_VALUE="$USERNAME_VALUE" \
    API_KEY="$API_KEY_VALUE" \
    "$REAL_EXEC" "$@"
