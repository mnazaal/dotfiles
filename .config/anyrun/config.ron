Config(
  // Position: Centered horizontally, upper third vertically
  x: Fraction(0.5),
  y: Fraction(0.3),
  
  // Width: Approximately 80ch
  width: Absolute(640),
  
  // Minimum height (expands to fit content)
  height: Absolute(1),
  
  // Show icons
  hide_icons: false,
  
  // Respect waybar/panels exclusive zones
  ignore_exclusive_zones: false,
  
  // Layer: Overlay for topmost position
  layer: Overlay,
  
  // Hide plugin info for cleaner look
  hide_plugin_info: true,
  
  // Don't close on click outside
  close_on_click: false,
  
  // Show results immediately on launch
  show_results_immediately: true,
  
  // Limit to 5 entries
  max_entries: Some(5),
  
  // Plugins: using paths in source build directory
  plugins: [
    "~/.config/anyrun/plugins/libapplications.so",
    "~/.config/anyrun/plugins/libshell.so"
  ],
  
  // Keybindings: Match rofi config
  keybinds: [
    Keybind(key: "Return", action: Select),
    Keybind(key: "Up", action: Up),
    Keybind(key: "Down", action: Down),
    Keybind(key: "j", action: Down, ctrl: true),
    Keybind(key: "k", action: Up, ctrl: true),
    Keybind(key: "Escape", action: Close),
    Keybind(key: "Tab", action: Down),
    Keybind(key: "ISO_Left_Tab", action: Up, shift: true),
  ],
)
