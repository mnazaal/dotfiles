# Never commit full Firefox profiles or runtime/secrets files.
.mozilla/firefox/*
!.mozilla/firefox/bpw3h4pa.BetterFox/
.mozilla/firefox/bpw3h4pa.BetterFox/*
!.mozilla/firefox/bpw3h4pa.BetterFox/user.js
!.mozilla/firefox/bpw3h4pa.BetterFox/chrome/
!.mozilla/firefox/bpw3h4pa.BetterFox/chrome/**
.config/mozilla/firefox/

# Local editor/system noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local env/secrets files
.env
.env.*
*.secret
*.secrets

# Common build/cache artifacts
node_modules/
coverage/
dist/
__pycache__/
.pytest_cache/

# Local agent/tool state
.opencode/
.kiro/

# Claude Code: track the curated config, ignore runtime/state and local overrides
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/keybindings.json
!.claude/install-mcp.sh
!.claude/agents/
!.claude/hooks/
!.claude/skills

# Machine-local render of .config/codex/config.toml.template
.config/codex/config.toml


# Standing plan and personal notes — local working documents, deliberately untracked
PLAN.md
wip.org

# Assets
.local/share/*
# gpg-agent cache TTLs: the setting that keeps tty-less cron jobs able to
# decrypt. Nothing secret here; the keyring itself stays ignored.
!.local/share/gnupg/
.local/share/gnupg/*
!.local/share/gnupg/gpg-agent.conf

# Logs
*.log
