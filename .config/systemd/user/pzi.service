# paperazzi capture server as a systemd *user* service.
#
# Installed and enabled by `make link` (stow, plus the tracked
# default.target.wants symlink). After changing this file:
#   systemctl --user daemon-reload && systemctl --user restart pzi.service
# `loginctl enable-linger "$USER"` keeps it running when logged out.
#
# Logs (no terminal needed):  journalctl --user -u pzi -f
#
# This wraps `pzi server` (the HTTP API on :8765 that the browser extension
# talks to). It deliberately does NOT manage the Zotero translation-server
# directly — `pzi server` spawns that as a bound child and reaps it on exit.

[Unit]
Description=paperazzi capture server
Documentation=https://github.com/mnazaal/paperazzi
After=network-online.target
Wants=network-online.target

[Service]
# The systemd user manager runs with the bare system PATH -- no ~/.local/bin,
# no fnm -- so pzi's shutil.which("node") finds nothing here and falls back to
# downloading a vendored Node. PZI_NODE names the binary directly and wins over
# PATH; pointing it at fnm's `default` alias survives version bumps, and pzi
# raises rather than silently downloading if it ever stops resolving.
Environment=PZI_NODE=%h/.local/share/fnm/aliases/default/bin/node
ExecStart=%h/.local/bin/pzi server
StandardOutput=append:%h/.local/share/pzi/server-stdout.log
StandardError=append:%h/.local/share/pzi/server-stderr.log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
