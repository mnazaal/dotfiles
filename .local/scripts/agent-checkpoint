#!/usr/bin/env bash
# agent-checkpoint — snapshot the working tree to
# refs/agent-checkpoint/<prefix>/<epoch>.
#
# Harness-agnostic: invoked by whatever per-turn hook each agent provides. It
# exists so the shared guardrail `ask` tier can be empty — allow-all rests on
# "git makes writes recoverable", but git only protects COMMITTED work. This
# captures uncommitted and untracked work too.
#
# Refs are namespaced by AGENT_BRANCH_PREFIX, the convention the shared git
# hooks already use, so two agents in one repo never collide.
#
# Uses a temporary index, not `git stash create`, which silently omits untracked
# files. The real index, working tree, HEAD, and stash stack are never touched.
# Never fails: this runs every turn, so every path ends in exit 0.
set -uo pipefail

# Exit 0 on every path (this runs each turn; wedging the session is worse than
# the prompts it replaces) — but never in silence. The guardrail `allow` tier
# for world-writable and recursive-force-rm is earned by this script working,
# so a checkpoint that stops working must say so where the turn can see it.
warn() {
	printf 'agent-checkpoint: %s: uncommitted work is NOT recoverable this turn\n' \
		"$1" >&2
	exit 0
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
[ -n "$(git status --porcelain 2>/dev/null)" ] || exit 0

# An unborn HEAD (a repo with no commits yet) has no tree to read and no commit
# to point at. That is where work is LEAST recoverable, so snapshot it anyway,
# parentless, instead of falling through to the silent no-op below.
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
	parent=(-p HEAD)
else
	parent=()
fi

idx=$(mktemp -u 2>/dev/null) || warn "could not create a temporary index"
tree=$(
	export GIT_INDEX_FILE="$idx"
	if [ ${#parent[@]} -gt 0 ]; then
		git read-tree HEAD 2>/dev/null || exit 1
	fi
	git add -A 2>/dev/null || exit 1
	git write-tree 2>/dev/null || exit 1
)
rm -f "$idx" 2>/dev/null || true
[ -n "$tree" ] || warn "could not write a tree (unreadable or unwritable repo?)"

sha=$(git commit-tree "$tree" "${parent[@]}" -m "agent checkpoint $(date -u +%FT%TZ)" 2>/dev/null) ||
	warn "could not commit the snapshot tree"
[ -n "$sha" ] || warn "commit-tree produced no object"

# Nanoseconds, not seconds: at second resolution two snapshots inside one
# second landed on the same ref name and the later one silently overwrote the
# earlier. %N is zero-padded to a fixed 9 digits, so refs keep sorting
# lexicographically in chronological order — including against the shorter
# second-resolution names written before this change.
git update-ref \
	"refs/agent-checkpoint/${AGENT_BRANCH_PREFIX:-agent}/$(date +%s%N)" \
	"$sha" 2>/dev/null || warn "could not update the checkpoint ref"

printf 'checkpoint %s\n' "$sha"
exit 0
