should_launch_new_window 1
case_sensitive_search 0
shared_database_path ~/org/bibliography/shared.db

# Python sioyek extensions from https://github.com/ahrm/sioyek-python-extensions.
# These called a bare `python`, which does not exist on this host (python3 only)
# and would not have the module anyway -- so every one of them silently did
# nothing, including the ctrl-click paper download. `uv run --with` resolves the
# package from uv's cache at call time, which needs no install step and no
# environment to maintain. uv itself is on PATH for a session-launched sioyek
# via .local/scripts/mango-session.
new_command _extract_highlights uv run --quiet --with sioyek python -m sioyek.extract_highlights "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%1" %{zoom_level}
new_command _embed_annotations  uv run --quiet --with sioyek python -m sioyek.embed_annotations "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}"
# paper_downloader alone needs two extras the package does not declare:
# undetected-chromedriver (it drives google-chrome, which is installed), and
# setuptools, because that driver still imports distutils, gone since 3.12.
new_command _download_paper     uv run --quiet --with sioyek --with undetected-chromedriver --with setuptools python -m sioyek.paper_downloader download "%{sioyek_path}" "%{paper_name}" "%{selected_text}"
new_command _import_annotations uv run --quiet --with sioyek python -m sioyek.import_annotations "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}"
new_command _remove_annotations uv run --quiet --with sioyek python -m sioyek.remove_annotation "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}"
new_command _add_text           uv run --quiet --with sioyek python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}"
new_command _add_red_text       uv run --quiet --with sioyek python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}" fontsize=5 text_color=255,0,0

control_click_command _download_paper

# Catppuccin theme
# use toggle_custom_color to enable
visual_mark_color 0.502 0.529 0.635 1.0
background_color 0.141 0.153 0.227
text_highlight_color 0.933 0.831 0.624
search_highlight_color 0.933 0.831 0.624
