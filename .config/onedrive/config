local_first = "true"
enable_logging = "true"

# Without this the client tries /var/log/onedrive, which it cannot create, and
# falls back to writing the activity log into the home directory root.
log_dir = "~/.local/state/onedrive/"

# Ubuntu 24.04 ships curl 8.5.0, which is on upstream's list of versions with
# known HTTP/2 bugs. The client already downgrades itself to HTTP/1.1 on
# detecting it; setting these two makes that explicit and demotes the warning
# from a desktop notification on every single sync to a line in the log. It
# silences the notification, not the underlying libcurl bug — the real fix is a
# curl newer than 8.6.
force_http_11 = "true"
ip_protocol_version = "1"

# The local mirror root. Its contents correspond one-to-one with sync_list —
# nothing else lives here, and nothing here is hand-made. Named for the job
# rather than the provider, so a second provider can sit beside it later.
# Changing this mandates a full --resync, so it is settled before the first
# download rather than after.
sync_dir = "~/sync"

# Symlinks inside the sync tree are never followed. This is a guard, not a
# preference: the previous ~/OneDrive contained Material/Papers as a symlink
# out to ~/Documents/Papers, so a --resync with an empty database walked out of
# the sync tree and queued 158 uploads of an unrelated directory. Links may
# point INTO this tree from elsewhere; links pointing out of it cannot.
skip_symlinks = "true"

# 10 GiB, raised from the client's 50 MB default. The drive holds 245 GB and
# this filesystem has ~145 GB free, so a mis-scoped sync_list would otherwise
# happily run / to within 50 MB of full and take the desktop down with it.
# The unit is MEBIBYTES, not bytes: the client multiplies this by 1048576, and
# `--display-config` reports the product. 10240 here reads back as 10737418240.
space_reservation = "10240"

# skip_file is deliberately not set. The default is `~*|.~*|*.tmp|*.swp|*.partial`
# — Office and LibreOffice lock files, temporaries and vim swap files — and
# defining our own would REPLACE those built-ins rather than add to them.

# Deletions pushed from the cloud go to Trash rather than off the disk.
# Added before the --resync that brought /Books/ into sync_list.
use_recycle_bin = "true"
