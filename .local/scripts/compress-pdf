#!/usr/bin/env bash
set -euo pipefail

show_help() {
	cat <<'EOF'
compress-pdf - reduce PDF file size using Ghostscript

USAGE:
  compress-pdf [--quality screen|ebook|printer|prepress] [--force] [INPUT [OUTPUT]]
  compress-pdf --help

DESCRIPTION:
  Compresses a PDF using Ghostscript. With no INPUT, select a PDF from the
  current directory using fzf. OUTPUT defaults to INPUT_compressed.pdf.

OPTIONS:
  --quality VALUE  Ghostscript PDFSETTINGS value (default: ebook)
  --force          Overwrite OUTPUT if it already exists

REQUIREMENTS:
  - ghostscript (`gs` command)
  - fzf only for interactive selection
EOF
}

quality=ebook
force=0

while (($#)); do
	case "$1" in
	-h | --help)
		show_help
		exit 0
		;;
	--quality)
		shift
		quality="${1:-}"
		;;
	--force)
		force=1
		;;
	--)
		shift
		break
		;;
	-*)
		echo "compress-pdf: unknown option: $1" >&2
		exit 2
		;;
	*)
		break
		;;
	esac
	shift
done

case "$quality" in
screen | ebook | printer | prepress) ;;
*)
	echo "compress-pdf: invalid quality: $quality" >&2
	exit 2
	;;
esac

command -v gs >/dev/null 2>&1 || {
	echo "compress-pdf: ghostscript (gs) is required" >&2
	exit 1
}

input="${1:-}"
output="${2:-}"

if [[ -z "$input" ]]; then
	command -v fzf >/dev/null 2>&1 || {
		echo "compress-pdf: fzf is required for interactive mode" >&2
		exit 1
	}
	input=$(find . -maxdepth 1 -type f -iname '*.pdf' | fzf --prompt="Choose input PDF: ") || {
		echo "compress-pdf: cancelled" >&2
		exit 1
	}
fi

[[ -n "$input" ]] || {
	echo "compress-pdf: no input selected" >&2
	exit 1
}
[[ -f "$input" ]] || {
	echo "compress-pdf: input not found: $input" >&2
	exit 1
}

if [[ -z "$output" ]]; then
	output="${input%.*}_compressed.pdf"
fi

if [[ -e "$output" && "$force" != 1 ]]; then
	echo "compress-pdf: output exists (use --force): $output" >&2
	exit 1
fi

echo "Compressing: $input -> $output ($quality)"
gs -sDEVICE=pdfwrite \
	-dCompatibilityLevel=1.4 \
	-dPDFSETTINGS="/$quality" \
	-dNOPAUSE \
	-dQUIET \
	-dBATCH \
	-sOutputFile="$output" \
	"$input"

echo "Created: $output"
