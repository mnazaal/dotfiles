    name = Nazaal
    email = 18580527+mnazaal@users.noreply.github.com
[diff]
    colorMoved = default
[log]
    date = iso-local
[alias]
    cl = clone --depth 1
    gm = merge
    gbl = branch --list
    gbd = branch --delete
    gsm = switch main
    gcm = commit -m
    gst = status --short --branch
    gds = diff --staged
    glo = log --oneline --decorate

    # Land an agent branch: step off it, fast-forward the base, retire it.
    # Agents commit on <prefix>/* because the reference-transaction hook refuses
    # them any other branch, and they cannot merge into the base or delete a
    # branch at all -- so landing is always the user's, and it is a fixed
    # three-command sequence whose ORDER is the whole difficulty. Handed over as
    # three commands it breaks whenever the agent left the checkout standing on
    # the branch: `merge --ff-only <b>` from <b> is a silent no-op reporting
    # "Already up to date", and `branch -d <b>` then refuses with "used by
    # worktree at <repo>" -- which names the primary checkout, so it reads as a
    # stray-worktree problem that does not exist. Ordering it once here is worth
    # more than any number of correct handover messages.
    land = "!f() { \
        b=${1:-}; \
        [ -n \"$b\" ] || { echo 'usage: git land <branch> [base]' >&2; exit 2; }; \
        base=${2:-}; \
        if [ -z \"$base\" ]; then \
            base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); \
            base=${base#origin/}; \
        fi; \
        base=${base:-main}; \
        git rev-parse --verify --quiet \"refs/heads/$b\" >/dev/null || { echo \"git land: no such branch: $b\" >&2; exit 1; }; \
        git merge-base --is-ancestor \"$base\" \"$b\" || { echo \"git land: $b has diverged from $base; rebase it first\" >&2; exit 1; }; \
        git checkout \"$base\" || exit 1; \
        git merge --ff-only \"$b\" || exit 1; \
        git branch --delete \"$b\"; \
      }; f"

    graph = log --graph --oneline --decorate --all --abbrev-commit --date=relative \
  --color --pretty=format:'%C(yellow)%h%C(reset)%C(cyan) (%ar)%C(reset) %s %C(green)%d%C(reset) %C(bold)<%an>%C(reset)'

    pullsub = "!f() { \
	   echo 'Pulling latest changes...'; \
	   git pull --recurse-submodules; \
	   echo 'Syncing submodules...'; \
	   git submodule sync --recursive; \
	   echo 'Updating submodules...'; \
	   git submodule update --init --recursive; \
	   }; f"

    fetchall = "!f() { \
        root=${1:-.}; \
        find \"$root\" \
          -type d -name .git \
          -not -path '*/.cache/*' \
          -not -path '*/node_modules/*' \
          -not -path '*/target/*' \
          -not -path '*/dist/*' \
          -not -path '*/.venv/*' \
          -exec sh -c 'for d in \"$@\"; do r=${d%/.git}; printf \"Fetching in %s\\n\" \"$r\"; git -C \"$r\" fetch --verbose; done' sh {} +; \
      }; f"
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[init]
    defaultBranch = main
[github]
    user = mnazaal
[core]
    # git-delta needs to be installed on system
    pager = delta
    hooksPath = ~/.config/git/hooks
    excludesFile = ~/.config/git/ignore
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true # use n and N to move between diff sections
    side-by-side = true
[push]
    autoSetupRemote = true
    followTags = true
[pull]
    rebase = false
    # Never let a pull invent a merge commit; diverged means rebase by hand.
    ff = only
[fetch]
    prune = true
    pruneTags = true
[merge]
    conflictStyle = zdiff3
    # Linear history. --no-ff overrides this, so the pre-merge-commit hook backs it.
    ff = only
[help]
    autocorrect = prompt
[commit]
    verbose = true
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[credential]
    helper = cache --timeout=3600
[credential "https://git.overleaf.com"]
    helper = "!f() { test \"$1\" = get && pass show overleaf-git 2>/dev/null | sed -n '1s/^/password=/p'; true; }; f"
