#!/usr/bin/env bash
# sandbox — run a command confined to an allowlist of directories, as a
# bubblewrap namespace. A profile's allowlist becomes bind mounts; everything
# else under $HOME stays invisible. See `sandbox --help`.
set -euo pipefail

H=$HOME
PROFILE_PATH=${SANDBOX_PROFILE_PATH:-${XDG_CONFIG_HOME:-$H/.config}/sandbox}

die() {
	printf 'sandbox: %s\n' "$1" >&2
	exit "${2:-1}"
}

show_help() {
	cat <<'EOF'
sandbox — run a command confined to an allowlist of directories

USAGE
  sandbox [options] [--] <command> [args...]
  sandbox --help

OPTIONS
  -p, --profile NAME|PATH   load a profile; a bare NAME resolves against
                            $SANDBOX_PROFILE_PATH (default ~/.config/sandbox),
                            a value containing '/' is a file path. Repeatable;
                            a profile may `use OTHER` to compose.
  -n, --dry-run             print the bwrap command instead of running it
  -h, --help                show this help

DESCRIPTION
  Only an allowlist is visible: the git repository containing the current
  directory is read-write (not $PWD alone -- a subdirectory launch still binds
  the repository root, or nothing at all outside a repository),
  system dirs and whatever profiles add are read-only, everything else under
  $HOME (ssh, gnupg, pass, other projects) is invisible. Secrets already in
  the environment pass through, so callers can resolve them beforehand.

  Env: $SANDBOX_PROFILE_PATH.
EOF
}

# --- profile loading ---------------------------------------------------------

find_profile() { # NAME -> path on $PROFILE_PATH, or fail
	local name=$1 dir
	local IFS=:
	for dir in $PROFILE_PATH; do
		if [ -f "$dir/$name.profile" ]; then
			printf '%s' "$dir/$name.profile"
			return 0
		fi
	done
	return 1
}

# `use NAME` — compose another profile by name (include-guarded). For profiles.
use() {
	local name=$1 f
	[ -z "${_loaded[$name]:-}" ] || return 0
	_loaded[$name]=1
	f=$(find_profile "$name") || die "profile not found: $name (searched: $PROFILE_PATH)"
	# shellcheck source=/dev/null
	. "$f"
}

load_profile_arg() { # -p value: a path (has '/') or a name on the search path
	case "$1" in
	*/*)
		[ -f "$1" ] || die "profile file not found: $1"
		# shellcheck source=/dev/null
		. "$1"
		;;
	*) use "$1" ;;
	esac
}

# Assert every pin that IS PRESENT is genuinely read-only INSIDE the boundary
# before the sandboxed command gets control. Fail-closed on the writable case
# only: a pin that is absent prints a warning and the command still runs, because
# refusing would brick the launcher whenever an optional tool is uninstalled.
# That asymmetry is deliberate but it is not "fail closed", and describing it as
# such hid the gap -- an absent pin is not bound, and its parent may be writable,
# so the path can be created inside and persist to the host. Emitting a read-only bind is a
# request; this is the only place the kernel's answer is read. `test -w` reports
# false on a read-only bind for both files and directories, so no mountinfo
# parsing is needed. Shared verbatim by both emitters, since it runs inside the
# boundary and knows nothing about which one built it.
#
# Two counts, because a pin that VANISHED and a pin that is WRITABLE are
# different failures. Passing only the surviving count would let a missing pin
# shrink the denominator and report success on a smaller set than was declared,
# which is the fail-open this whole check exists to remove.
PREFLIGHT='declared=$1; n=$2; shift 2
if [ "$n" -ne "$declared" ]; then
	printf "sandbox: %s of %s machinery pins are missing from the container and are unprotected\n" \
		"$((declared - n))" "$declared" >&2
	printf "sandbox: continuing — a declared pin whose file does not exist cannot be enforced\n" >&2
fi
while [ "$n" -gt 0 ]; do
	if [ -w "$1" ]; then
		printf "sandbox: FATAL machinery pin is writable, so it is not enforced: %s\n" "$1" >&2
		printf "sandbox: refusing to start.\n" >&2
		exit 78
	fi
	shift
	n=$((n - 1))
done
exec "$@"'

run_bwrap() {
	command -v bwrap >/dev/null 2>&1 || die 'bwrap not found in PATH' 127
	local d target
	local p=(--unshare-user --unshare-ipc --unshare-pid --unshare-uts --die-with-parent)
	# The network is shared. Egress is not this boundary's job (PLAN, Open
	# risks: exfiltration is accepted, not mitigated), and nothing asked for
	# an opt-out.

	# No image supplies a root filesystem here, so build one. This is the one
	# place the two engines genuinely differ in WHAT is bound rather than how:
	# podman took /etc from the ubuntu image and added only /etc/ssl from the
	# host, while bwrap has no image, so /etc comes read-only from the host and
	# carries resolv.conf, hosts, passwd and the CA bundle in one bind.
	p+=(--proc /proc --dev /dev)
	for d in /usr /opt /etc; do
		if [ -e "$d" ]; then p+=(--ro-bind "$d" "$d"); fi
	done
	# usrmerge: /bin and friends are symlinks on this host and must be recreated
	# as symlinks, not bound — binding the target would work but would leave
	# `readlink /bin` disagreeing with the host and break nothing visibly, which
	# is the kind of difference that surfaces months later.
	for d in /bin /sbin /lib /lib32 /lib64 /libx32; do
		if [ -L "$d" ]; then
			target=$(readlink "$d")
			p+=(--symlink "$target" "$d")
		elif [ -d "$d" ]; then
			p+=(--ro-bind "$d" "$d")
		fi
	done
	# /etc/resolv.conf is a symlink into /run on a systemd-resolved host, and /run
	# is deliberately not bound, so the read-only /etc above lands a DANGLING
	# symlink: name resolution fails inside with nothing more diagnostic than
	# "Temporary failure in name resolution". Bind the file at ITS OWN path so the
	# symlink already in /etc resolves; binding it AT /etc/resolv.conf instead
	# fails, because bwrap follows that symlink to create the destination and
	# lands in the /run that is not there. podman never hit this — its image
	# shipped a real resolv.conf that podman rewrote per network.
	local resolv
	if resolv=$(readlink -f /etc/resolv.conf 2>/dev/null) && [ -f "$resolv" ]; then
		p+=(--ro-bind "$resolv" "$resolv")
	fi
	p+=(--tmpfs /tmp)
	# Everything under $HOME is invisible unless the allowlist binds it back.
	# bwrap's root is already a fresh tmpfs, so this is belt-and-braces against a
	# future base bind that would otherwise expose the home directory.
	p+=(--tmpfs "$H")

	for d in "${RO[@]}"; do if [ -e "$d" ]; then p+=(--ro-bind "$d" "$d"); fi; done
	for d in "${RW[@]}"; do if [ -e "$d" ]; then p+=(--bind "$d" "$d"); fi; done
	# Emitted last so a pin nested inside a writable bind stays read-only. The
	# manual guarantees binds are "applied in the order they are given as
	# arguments", and PLAN's A2 measured that this holds for a REPEATED
	# DESTINATION too: the later bind wins rather than erroring, which is why the
	# no dedupe pass is needed, or wanted.
	for d in "${RO_LAST[@]}"; do if [ -e "$d" ]; then p+=(--ro-bind "$d" "$d"); fi; done
	# A mask makes the path ABSENT rather than merely unwritable. bwrap's --tmpfs
	# has no copy-up, so podman's load-bearing notmpcopyup has nothing to
	# correspond to: there is no replica to make and no creation timeout to hit.
	for d in "${MASK[@]}"; do if [ -e "$d" ]; then p+=(--perms 0000 --tmpfs "$d"); fi; done

	# An LDAP/sssd-backed user is absent from /etc/passwd, so the read-only bind
	# above leaves the uid unresolvable and Node's os.userInfo() throws
	# ERR_SYSTEM_ERROR -- inside an agent written in exactly that runtime. podman
	# hid this: --userns=keep-id synthesizes a passwd entry for the mapped user.
	#
	# Resolve the lines ONCE, here, and check them. The first version of this
	# called getent in the guard and AGAIN inside the process substitution, where a
	# non-zero exit is invisible to the shell: a transient sssd failure between the
	# two calls produced a syntactically valid /etc/passwd that simply lacked the
	# user -- silently reintroducing the throw this code exists to prevent -- and a
	# hang there blocked bwrap during setup with no message at all. What is left in
	# the substitution below runs `cat` and `printf` only, so it cannot block on
	# the directory.
	local passwd_line="" group_line="" uid gid
	uid=$(id -u)
	gid=$(id -g)
	if ! awk -F: -v u="$uid" '$3 == u { found = 1 } END { exit !found }' /etc/passwd 2>/dev/null; then
		# Independently, because they fail independently. Measured on this host: the
		# group lookup for this gid returned exit 2 with empty output once, then
		# succeeded on ten consecutive retries — a transient directory failure, not a
		# permanent one. Coupling them meant that single blip suppressed the passwd
		# entry too, silently restoring the os.userInfo() throw. There is no test for
		# this: any test would have to make NSS fail on demand, and one that merely
		# runs the lookup passes vacuously whenever the directory is healthy.
		passwd_line=$(getent passwd "$uid" 2>/dev/null) || passwd_line=""
		group_line=$(getent group "$gid" 2>/dev/null) || group_line=""
		if [ -z "$passwd_line" ]; then
			printf 'sandbox: uid %s is not in /etc/passwd and NSS did not resolve it;\n' "$uid" >&2
			printf 'sandbox: continuing without it — expect os.userInfo() to fail inside.\n' >&2
		fi
	fi

	p+=(--chdir "$PWD")
	# Non-secret, and the only marker of this boundary: bwrap creates neither
	# /run/.containerenv nor /.dockerenv, so the pi shim tests this instead to
	# recognise that it is already inside a sandbox.
	p+=(--setenv SANDBOX_ENGINE bwrap)

	# Only allowlisted names cross. bwrap inherits the environment wholesale, so
	# everything else is dropped with --unsetenv, which takes a NAME and never a
	# value -- the same reason the podman path passes a bare `--env NAME`. Do NOT
	# do this by unsetting in the launcher instead: `unset -v "$name"` inside a
	# function unsets the nearest enclosing LOCAL of that name, so an exported
	# `keep` or `allowed` survived while an exported `p` destroyed this very argv
	# array. Measured 2026-09-06; that is a class of bug rather than an instance,
	# and --unsetenv removes the class by never touching this shell's state.
	# Accepted cost: the NAMES of non-allowlisted variables become visible in argv
	# via `ps`. Names only, never values.
	local envname keep allowed
	while IFS= read -r envname; do
		keep=0
		for allowed in "${SANDBOX_ENV[@]}"; do
			if [ "$envname" = "$allowed" ]; then
				keep=1
				break
			fi
		done
		[ "$keep" -eq 1 ] || p+=(--unsetenv "$envname")
	done < <(compgen -e)

	local pins=() d2
	for d2 in "${RO_LAST[@]}"; do
		if [ -e "$d2" ]; then pins+=("$d2"); fi
	done

	if [ "$DRYRUN" -eq 1 ]; then
		# A descriptor number would be meaningless outside this process, so print a
		# placeholder: the reconstruction is shown, and the line is not passed off as
		# runnable.
		if [ -n "$passwd_line" ]; then
			p+=(--ro-bind-data PASSWD_FD /etc/passwd)
		fi
		if [ -n "$group_line" ]; then
			p+=(--ro-bind-data GROUP_FD /etc/group)
		fi
		printf 'bwrap'
		printf ' %q' "${p[@]}" -- \
			/bin/sh -c "$PREFLIGHT" sandbox-preflight "${#RO_LAST[@]}" "${#pins[@]}" "${pins[@]}" "${cmd[@]}"
		printf '\n'
		exit 0
	fi
	if [ -n "$SANDBOX_PATH_PREPEND" ]; then PATH="$SANDBOX_PATH_PREPEND:$PATH"; fi
	local passwd_fd group_fd
	if [ -n "$passwd_line" ]; then
		exec {passwd_fd}< <(
			cat /etc/passwd
			printf '%s\n' "$passwd_line"
		)
		p+=(--ro-bind-data "$passwd_fd" /etc/passwd)
	fi
	if [ -n "$group_line" ]; then
		exec {group_fd}< <(
			cat /etc/group
			printf '%s\n' "$group_line"
		)
		p+=(--ro-bind-data "$group_fd" /etc/group)
	fi
	exec bwrap "${p[@]}" -- \
		/bin/sh -c "$PREFLIGHT" sandbox-preflight "${#RO_LAST[@]}" "${#pins[@]}" "${pins[@]}" "${cmd[@]}"
}

# --- run ---------------------------------------------------------------------

# accumulators — profiles and flags append to these
# RO_LAST is emitted AFTER every RW bind, so a read-only path nested inside a
# writable one stays read-only. Plain RO is emitted first, where an overlapping
# RW bind wins — which is why the read-only $H/.agents bind does not protect
# its stow targets under the writable $H/dotfiles bind.
declare -a RW=() RO=() RO_LAST=() MASK=()
# Only these non-secret host variables cross the sandbox boundary by default.
# Profiles append the minimal harness-specific variables (including any required
# launch-time credential) to SANDBOX_ENV.
declare -a SANDBOX_ENV=(HOME PWD PATH LANG LC_ALL LC_CTYPE TERM COLORTERM NO_COLOR EDITOR VISUAL XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_RUNTIME_DIR XDG_STATE_HOME WAYLAND_DISPLAY)
DRYRUN=0
SANDBOX_PATH_PREPEND=""
declare -A _loaded=()

cmd=()
while [ $# -gt 0 ]; do
	case "$1" in
	-p | --profile)
		load_profile_arg "$2"
		shift 2
		;;
	-n | --dry-run)
		DRYRUN=1
		shift
		;;
	-h | --help)
		show_help
		exit 0
		;;
	--)
		shift
		cmd=("$@")
		break
		;;
	-*) die "unknown option: $1" ;;
	*)
		cmd=("$@")
		break
		;;
	esac
done

[ ${#cmd[@]} -gt 0 ] ||
	die 'usage: sandbox [options] [--] <command> [args...]' 2

cmdpath=$(command -v -- "${cmd[0]}") || die "command not found: ${cmd[0]}" 127
cmd[0]=$cmdpath

realhome=$(readlink -f "$H")
realcwd=$(readlink -f "$PWD")
is_home_or_ancestor() {
	case "$realhome/" in "$1"/*) return 0 ;; esac
	return 1
}

# Reject binds that would re-expose all of $HOME or /, including ancestors of
# $HOME such as /home. Such a bind defeats the allowlist just as completely.
for d in "${RW[@]}" "${RO[@]}" "${RO_LAST[@]}" "${MASK[@]}"; do
	rd=$(readlink -f "$d" 2>/dev/null || printf '%s' "$d")
	if [ "$rd" = "/" ] || is_home_or_ancestor "$rd"; then
		die "refusing to bind '$d' — it re-exposes all of \$HOME or /"
	fi
done

# The writable unit is the REPOSITORY, not $PWD. Two failures come from getting
# this wrong, and both are silent:
#   - from a SUBDIRECTORY, binding only $PWD leaves .git under a read-only bind,
#     so the agent edits files it can never commit;
#   - from a directory that CONTAINS repositories, binding $PWD read-write is
#     emitted after the profile's read-only entry and therefore WINS, which is
#     how `cd ~/projects && pi` made every sibling project writable (measured
#     2026-09-07, confirmed on the host).
# A git worktree is what distinguishes a project from a container of projects,
# so ask git rather than matching names.
covered_by_readonly() { # path -> 0 when a profile already binds it read-only
	local target=$1 d
	for d in "${RO[@]}" "${RO_LAST[@]}"; do
		[ "$target" = "$d" ] || [ "${target#"$d"/}" != "$target" ] || continue
		return 0
	done
	return 1
}

rw_unit=$PWD
in_worktree=0
if _top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) && [ -n "$_top" ]; then
	rw_unit=$_top
	in_worktree=1
fi

if [ "$realcwd" = "$realhome" ] || is_home_or_ancestor "$realcwd"; then
	printf 'sandbox: nothing writable added: cwd is $HOME or above. Run inside a\n' >&2
	printf '         git repository for a writable checkout.\n' >&2
	[ ${#RW[@]} -gt 0 ] || die 'empty writable allowlist from $HOME — refusing to run'
elif [ "$in_worktree" -eq 0 ] && covered_by_readonly "$rw_unit"; then
	# Deliberately NOT an error: a read-only launch here is still useful, and
	# refusing outright would make a mistyped path look like a broken sandbox.
	# The message says what to DO, not which two conditions were true: the
	# remedy is the same in every case, and naming the conditions invites a
	# guess about what this particular directory is.
	printf 'sandbox: nothing writable added: cwd is read-only in this profile.\n' >&2
	printf '         Run inside a git repository for a writable checkout.\n' >&2
	[ ${#RW[@]} -gt 0 ] || die 'nothing writable — refusing to run'
else
	RW+=("$rw_unit")
	# A linked worktree keeps its real git directory in the MAIN repository,
	# which may sit under a read-only bind — bind it too or nothing commits.
	# --git-common-dir is relative in a normal checkout and absolute in a linked
	# worktree, so resolve before comparing.
	if [ "$in_worktree" -eq 1 ] &&
		_common=$(git -C "$PWD" rev-parse --git-common-dir 2>/dev/null) &&
		_common=$(cd "$_common" 2>/dev/null && pwd); then
		case "$_common" in
		"$rw_unit" | "$rw_unit"/*) ;;
		*) RW+=("$_common") ;;
		esac
	fi
fi

# Profiles are trusted shell snippets, but environment names still need to be
# valid before indirect expansion below.
declare -A _seen_env=()
env_out=()
for name in "${SANDBOX_ENV[@]}"; do
	[[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid sandbox environment name: $name"
	[ -z "${_seen_env[$name]:-}" ] || continue
	_seen_env[$name]=1
	env_out+=("$name")
done
SANDBOX_ENV=("${env_out[@]}")

run_bwrap
