# Real per-host entries live in the git-ignored, machine-local ~/.ssh/config.local
Include ~/.ssh/config.local

# github: short one-shot pushes/fetches (e.g. the `hpc` script's `git push`)
# gain nothing from a persistent master, and an interrupted connect while
# off-VPN used to leave a wedged cm-* socket that hung every later push over
# it. Disable multiplexing here so each git operation dials fresh. This block
# precedes `Host *` because SSH takes the first value seen per keyword.
Host github.com
    ControlMaster no

# Generic defaults for every host. SSH uses the first value seen for each
# keyword, and per-host options in config.local are read first via the Include
# above, so those win; these apply only as fallbacks.
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    # Fail a stalled connect fast instead of hanging indefinitely -- an
    # unreachable host (e.g. running before the VPN is up) then errors out
    # rather than wedging, and never leaves a half-open master behind.
    ConnectTimeout 10
    ControlMaster auto
    # Keep the mux socket directly under the user's ~/.ssh so it does not depend
    # on an untracked empty ~/.ssh/sockets directory existing on every machine.
    # %d avoids symlink/tilde ambiguity, and %C avoids path-length and unsafe
    # character issues from %r@%h:%p.
    ControlPath %d/.ssh/cm-%C
    ControlPersist 10m
