{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] || exit 0; out=$(\"$f\" 2>&1 >/dev/null); [ -n \"$out\" ] && { printf '%s\\n' \"$out\"; printf '%s\\n' \"$out\" >&2; }; exit 0",
            "timeout": 30,
            "statusMessage": "Snapshotting working tree"
          },
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/sandbox\"; if [ -x \"$f\" ] && [ -e /run/.containerenv ]; then if ! out=$(\"$f\" -p agent-codex --verify-pins 2>&1); then printf '%s\\n' \"$out\"; printf '%s\\n' \"$out\" >&2; exit 1; fi; fi; exit 0",
            "timeout": 30,
            "statusMessage": "Verifying machinery pins"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CODEX_HOME/hooks/guardrails.ts\"",
            "timeout": 30,
            "statusMessage": "Checking shared guardrails"
          },
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] || exit 0; out=$(\"$f\" 2>&1 >/dev/null); [ -n \"$out\" ] && { printf '%s\\n' \"$out\"; printf '%s\\n' \"$out\" >&2; }; exit 0",
            "timeout": 30,
            "statusMessage": "Snapshotting working tree"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CODEX_HOME/hooks/guardrails.ts\"",
            "timeout": 30,
            "statusMessage": "Checking shared guardrails"
          }
        ]
      }
    ]
  }
}
