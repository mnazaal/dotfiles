* {
    background:         #1e1e2e;
    foreground:         #cdd6f4;
    foreground-alt:     #cad3f5;
    accent:             #ed8796;
    selection:          #6c7086;
    border:             rgba(255, 255, 255, 93%);
    font:               "Iosevka Term 12";
}

window {
    anchor: center;
    location: center;
    width: 80ch;
    border: 1px;
    border-color: @border;
    border-radius: 0px;
    background-color: @background;
    padding: 0px;
}

mainbox {
    background-color: @background;
    spacing: 0px;
    children: [ "inputbar", "listview" ];
}

listview {
    background-color: @background;
    columns: 1;
    lines: 5;
    fixed-height: true;
    scrollbar: false;
    spacing: 0px;
    padding: 0px 0px 2px 0px;
}

element {
    background-color: @background;
    text-color: @foreground;
    padding: 0px 8px;
    spacing: 8px;
    children: [ "element-icon", "element-text" ];
}

element normal.normal,
element alternate.normal {
    background-color: @background;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selection;
    text-color: @foreground-alt;
}

scrollbar {
    width: 0px;
    handle-width: 0px;
    padding: 0px;
}

inputbar {
    background-color: @background;
    text-color: @foreground;
    spacing: 8px;
    padding: 8px;
    children: [ "prompt", "entry" ];
}

entry {
    background-color: @background;
    text-color: @foreground;
    cursor: text;
    placeholder: "";
    padding: 2px 0px;
}

prompt {
    background-color: @background;
    text-color: @foreground;
    padding: 2px 0px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    highlight: @accent;
    vertical-align: 0.5;
}

element-icon {
    background-color: inherit;
    text-color: inherit;
    size: 1em;
}
