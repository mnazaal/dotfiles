IMAPAccount gmail
Host imap.gmail.com
UserCmd "pass show primary-gmail"
PassCmd "pass show primary-gmail-secret"
TLSType IMAPS
CertificateFile /etc/ssl/certs/ca-certificates.crt

IMAPStore gmail-remote
Account gmail

MaildirStore gmail-local
Subfolders Verbatim
Path ~/.local/share/mail/gmail/
Inbox ~/.local/share/mail/gmail/inbox

# The inbox channel predates the others and keeps its sync state in
# ~/.local/state/mbsync/; the rest store state in the maildir (SyncState *).
# Deliberately left split: relocating existing sync state makes mbsync treat
# already-synced mail as new.
Channel gmail-inbox
Far ":gmail-remote:INBOX"
Near ":gmail-local:inbox"
Create Both
SyncState ~/.local/state/mbsync/
CopyArrivalDate yes

Channel gmail-drafts
Far ":gmail-remote:[Gmail]/Drafts"
Near ":gmail-local:drafts"
Create Both
SyncState *
CopyArrivalDate yes

Channel gmail-sent
Far ":gmail-remote:[Gmail]/Sent Mail"
Near ":gmail-local:sent"
Create Both
SyncState *
CopyArrivalDate yes

Channel gmail-archive
Far ":gmail-remote:[Gmail]/All Mail"
Near ":gmail-local:archive"
Create Both
SyncState *
CopyArrivalDate yes

Channel gmail-trash
Far ":gmail-remote:[Gmail]/Trash"
Near ":gmail-local:trash"
Create Both
SyncState *
CopyArrivalDate yes

# Cadence split. All Mail is ~58k messages; polling it every 5 minutes along
# with the small boxes throttles the account's IMAP access (mbsync socket
# timeouts, and rss2email's appends stretched a 17-message run to 19 minutes).
# The small boxes stay on the 5-minute cron; gmail-archive gets its own hourly
# job. `mbsync -a` selects every channel, All Mail included, so both cron jobs
# name what they sync instead.
Group gmail-fast
Channel gmail-inbox
Channel gmail-drafts
Channel gmail-sent
Channel gmail-trash
