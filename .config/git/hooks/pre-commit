#!/bin/bash
set -euo pipefail

ERROR_PREFIX="GIT PRE-COMMIT HOOK ERROR:"

# Coding-agent branch namespacing: agents may only touch <prefix>/* branches.
# Prefix comes from AGENT_BRANCH_PREFIX: claude sets it in settings.json's
# `env` block, pi in its guardrails extension.
# Empty => human.
PREFIX="${AGENT_BRANCH_PREFIX:-}"

# See reference-transaction for why this is a kernel fact and not just the
# variable: an agent can unset AGENT_BRANCH_PREFIX, but it cannot make a
# read-only bind writable. The marker must exist to count, so a machine without
# it degrades to the variable alone.
CONFINED_MARKER="$HOME/.claude/settings.json"
CONFINED=0
if [[ -n "$PREFIX" ]]; then CONFINED=1; fi
if [[ -e "$CONFINED_MARKER" && ! -w "$CONFINED_MARKER" ]]; then CONFINED=1; fi
if [[ "$CONFINED" == 1 && -z "$PREFIX" ]]; then
	echo "$ERROR_PREFIX confined agent with no AGENT_BRANCH_PREFIX (environment cleared?); refusing" >&2
	exit 1
fi
if [[ "$CONFINED" == 1 ]]; then
	BRANCH="$(git symbolic-ref --quiet --short HEAD || true)"
	if [[ -z "$BRANCH" ]]; then
		# Detached HEAD is only allowed mid-rebase of a $PREFIX/* branch (e.g.
		# interactive rebase 'edit'/'reword' running git commit). The branch
		# ref is reattached at rebase end, where reference-transaction still
		# enforces the $PREFIX/* boundary, so this can't touch protected refs.
		REBASE_HEAD=""
		for d in rebase-merge rebase-apply; do
			p="$(git rev-parse --git-path "$d/head-name" 2>/dev/null)"
			[[ -f "$p" ]] && {
				REBASE_HEAD="$(cat "$p")"
				break
			}
		done
		ORIG="${REBASE_HEAD#refs/heads/}"
		if [[ -z "$ORIG" || ("$ORIG" != "$PREFIX"/* && "$ORIG" != worktree-"$PREFIX"*) ]]; then
			echo "$ERROR_PREFIX $PREFIX agent must commit to $PREFIX/* (or worktree-$PREFIX*) branches (got 'detached HEAD'${REBASE_HEAD:+, rebasing '$ORIG'})" >&2
			exit 1
		fi
	elif [[ "$BRANCH" != "$PREFIX"/* && "$BRANCH" != worktree-"$PREFIX"* ]]; then
		echo "$ERROR_PREFIX $PREFIX agent must commit to $PREFIX/* (or worktree-$PREFIX*) branches (got '$BRANCH')" >&2
		exit 1
	fi
fi

# A merge that stopped on conflicts is finished by a plain `git commit`, which
# never reaches pre-merge-commit -- so the linear-history rule is enforced here
# too. MERGE_HEAD is merge-specific: a conflicted rebase, stash pop or
# cherry-pick does not set it (verified), so this cannot fire on those.
if [[ -e "$(git rev-parse --git-path MERGE_HEAD)" && "${ALLOW_MERGE_COMMIT:-0}" != 1 ]]; then
	echo "$ERROR_PREFIX refusing to commit a merge (history is kept linear)." >&2
	echo "Abandon it with 'git merge --abort', then rebase and 'git merge --ff-only'." >&2
	echo "If the merge commit is genuinely wanted: ALLOW_MERGE_COMMIT=1 git commit ..." >&2
	exit 1
fi

# Leftover merge-conflict markers (zdiff3 uses ||||||| for the base).
conflicts="$(
	git diff --cached --no-color --diff-filter=d -U0 |
		grep -E '^\+(<<<<<<< |\|\|\|\|\|\|\| |>>>>>>> )' || true
)"
if [[ -n "$conflicts" ]]; then
	echo "$ERROR_PREFIX merge-conflict markers staged:" >&2
	printf '%s\n' "$conflicts" >&2
	exit 1
fi

THRESHOLD_MB=5
THRESHOLD=$((THRESHOLD_MB * 1024 * 1024))
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
	BASE=HEAD
else
	BASE="$(git hash-object -t tree /dev/null)"
fi
bad=()
while IFS= read -r -d '' f; do
	s="$(git cat-file -s ":$f" 2>/dev/null || printf '0')"
	[[ "$s" =~ ^[0-9]+$ ]] || s=0
	((s > THRESHOLD)) && bad+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=A "$BASE" --)
((${#bad[@]} == 0)) && exit 0
echo "$ERROR_PREFIX Refusing commit - large file(s) staged (>${THRESHOLD_MB}MB):" >&2
for f in "${bad[@]}"; do
	echo "  - $f" >&2
done
echo "Tip: use Git LFS or reduce file size." >&2
exit 1
