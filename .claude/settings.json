{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(~/projects/**)",
      "Write(~/projects/**)",
      "Edit(/tmp/**)",
      "Write(/tmp/**)",
      "WebSearch",
      "WebFetch",
      "mcp__asta-mcp",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(cat:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(pyright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.gpg/**)",
      "Read(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.password-store/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(./.env)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.gnupg/**)",
      "Write(./.env)",
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git branch -D:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(git tag -d:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear)",
      "Bash(find:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/guardrails.ts\"; [ -f \"$f\" ] && bun \"$f\" || exit 0"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "diffTool": "auto"
}
