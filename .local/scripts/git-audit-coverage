#!/usr/bin/env python3
"""Human-audit coverage of a git tree, computed from blame trailers.

A line counts as audited when the commit that last touched it carries a
`Human-audited: yes` trailer — added by dev-git only when the user confirmed
reviewing every staged hunk (review-loop's staging ledger). Rewriting a line
reassigns its blame, so re-edited code correctly drops back to unaudited.

Usage: git-audit-coverage [path ...]    # defaults to all tracked files
       git audit-coverage src/          # also works as a git subcommand
"""

import subprocess
import sys


def git(*args: str, **kwargs) -> str:
    return subprocess.run(
        ["git", *args], check=True, capture_output=True, text=True, **kwargs
    ).stdout


def blame_counts(path: str) -> dict[str, int]:
    """Map commit sha -> number of lines it owns in `path`."""
    counts: dict[str, int] = {}
    try:
        out = git("blame", "--line-porcelain", "--", path)
    except subprocess.CalledProcessError:
        return counts  # binary, unmerged, or otherwise unblameable: skip
    for line in out.splitlines():
        # Header lines start with "<40-hex sha> <orig> <final> [count]".
        parts = line.split(" ", 1)
        sha = parts[0]
        if len(sha) == 40 and all(c in "0123456789abcdef" for c in sha):
            counts[sha] = counts.get(sha, 0) + 1
    return counts


def audited_shas(shas: set[str]) -> set[str]:
    if not shas:
        return set()
    out = git(
        "log",
        "--no-walk=unsorted",
        "--stdin",
        "--format=%H %(trailers:key=Human-audited,valueonly,separator=,)",
        input="\n".join(s for s in shas if set(s) != {"0"}),
    )
    audited = set()
    for line in out.splitlines():
        sha, _, value = line.partition(" ")
        if value.strip().lower() == "yes":
            audited.add(sha)
    return audited


def main() -> int:
    paths = sys.argv[1:]
    files = git("ls-files", "--", *paths).splitlines()
    if not files:
        print("no tracked files match", file=sys.stderr)
        return 1

    per_file = {f: blame_counts(f) for f in files}
    all_shas = {sha for counts in per_file.values() for sha in counts}
    audited = audited_shas(all_shas)

    grand_total = grand_audited = 0
    for f, counts in per_file.items():
        total = sum(counts.values())
        if total == 0:
            continue
        ok = sum(n for sha, n in counts.items() if sha in audited)
        grand_total += total
        grand_audited += ok
        print(f"{ok:6d}/{total:<6d} {100 * ok / total:5.1f}%  {f}")

    if grand_total:
        pct = 100 * grand_audited / grand_total
        print(f"{grand_audited:6d}/{grand_total:<6d} {pct:5.1f}%  TOTAL")
    return 0


if __name__ == "__main__":
    sys.exit(main())
