#!/bin/bash

set -euo pipefail

# Renders a temporary notmuch config from the tracked public one with the
# primary email injected from pass, then delegates to the real binary.
NOTMUCH_BASE_CONFIG="$HOME/.config/notmuch/default/config"
NOTMUCH_EMAIL_ENTRY="primary-gmail"
REAL_NOTMUCH=$(command -v notmuch || echo "$HOME/.local/bin/notmuch")

[ -x "$REAL_NOTMUCH" ] || {
	echo "notmuch: command not found" >&2
	exit 127
}

[ -f "$NOTMUCH_BASE_CONFIG" ] || {
	echo "notmuch: config not found: $NOTMUCH_BASE_CONFIG" >&2
	exit 1
}

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

cp "$NOTMUCH_BASE_CONFIG" "$tmp"

primary=$(pass show "$NOTMUCH_EMAIL_ENTRY" | sed -n '1p')

[ -n "$primary" ] || {
	echo "notmuch: no email found in pass entry: $NOTMUCH_EMAIL_ENTRY" >&2
	exit 1
}

"$REAL_NOTMUCH" --config "$tmp" config set user.primary_email "$primary"

# Not exec: it replaces the shell and discards the EXIT trap, leaving the
# rendered config — which contains the primary email address — in /tmp after every run.
"$REAL_NOTMUCH" --config "$tmp" "$@"
