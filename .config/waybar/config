{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 5,
    "modules-left": [],
    "modules-center": ["clock"],
    "modules-right": [
        "tray", "custom/separator",
        "cpu", "custom/separator",
        "memory", "custom/separator",
        "pulseaudio", "custom/separator",
        "battery", "custom/separator",
        "bluetooth", "custom/separator",
        "network", "custom/separator",
        "group/power"
    ],

    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "not-power",
            "transition-left-to-right": false
            },
        "modules": [
            "custom/shutdown",
            "custom/lock",
            "custom/separator",
            "custom/reboot",
            "custom/separator"
            ]
    },

    "memory": {
        "interval": 30,
        "format": "{used:0.1f} GB",
        "max-length": 10
    },

    "cpu": {
        "interval": 5,
        "format": "{icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
        "format-icons": [
            "<span color='#a6e3a1'>▁</span>",
            "<span color='#89b4fa'>▂</span>",
            "<span color='#cdd6f4'>▃</span>",
            "<span color='#cdd6f4'>▄</span>",
            "<span color='#f9e2af'>▅</span>",
            "<span color='#f9e2af'>▆</span>",
            "<span color='#fab387'>▇</span>",
            "<span color='#f38ba8'>█</span>"
        ]
    },

    "clock": {
        "format": "{:%a %Y-%m-%d %H:%M}"
    },

    "pulseaudio": {
        "format": "\uf028  {volume}% {format_source}",
        "format-bluetooth": "\uf293 {volume}% {format_source}",
        "format-bluetooth-muted": "\ueee8 \uf293  {format_source}",
        "format-muted": "\ueee8  {format_source}",
        "format-source": "\uf130 {volume}%",
        "format-source-muted": "\uf131 ",
        "on-click": "zsh -c 'source ~/.config/zsh/.zshenv; exec pwvucontrol'"
    },

    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2 ",
        "format-connected": "\udb80\udcaf {device_alias}",
        "format-connected-battery": "\udb80\udcaf {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "format": "{icon}  {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "on-click": "zsh -c 'source ~/.config/zsh/.zshenv; exec gnome-power-statistics'"
    },

    "network": {
        "format": "",
        "format-ethernet": "\udb83\udc9d ",
        "format-wifi": "{icon}",
        "format-disconnected": "\udb83\udc9c ",
        "format-icons": ["\udb82\udd2f ", "\udb82\udd1f ", "\udb82\udd22 ", "\udb82\udd25 ", "\udb82\udd28 "],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "\uF127 ",
        "on-click": "zsh -c 'source ~/.config/zsh/.zshenv; exec nm-connection-editor'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 16
    },

    "custom/separator": {
        "format": "│",
        "tooltip": false
    },

    "custom/lock": {
        "tooltip": false,
        "on-click": "$HOME/.local/scripts/lock-screen",
        "format": "\udb80\udf43 "
    },

    "custom/reboot": {
        "tooltip": false,
        "on-click": "zsh -c 'source ~/.config/zsh/.zshenv; zenity --question --timeout=10 --text=\"Reboot in 10 seconds unless cancelled.\" --ok-label=\"Reboot\" --cancel-label=\"Cancel\"; r=$?; if [ \"$r\" -eq 0 ] || [ \"$r\" -eq 5 ]; then reboot; fi'",
        "format": "\udb81\udf09 "
    },

    "custom/shutdown": {
        "tooltip": false,
        "on-click": "zsh -c 'source ~/.config/zsh/.zshenv; zenity --question --timeout=10 --text=\"Shutdown in 10 seconds unless cancelled.\" --ok-label=\"Shutdown\" --cancel-label=\"Cancel\"; r=$?; if [ \"$r\" -eq 0 ] || [ \"$r\" -eq 5 ]; then shutdown -h now; fi'",
        "format": "\udb81\udc25 "
    }
}
