{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] && \"$f\" >/dev/null 2>&1; exit 0",
            "timeout": 30,
            "statusMessage": "Snapshotting working tree"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CODEX_HOME/hooks/guardrails.ts\"",
            "timeout": 30,
            "statusMessage": "Checking shared guardrails"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CODEX_HOME/hooks/guardrails.ts\"",
            "timeout": 30,
            "statusMessage": "Checking shared guardrails"
          }
        ]
      }
    ]
  }
}
