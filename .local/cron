# Edit this file to introduce tasks to be run by cron.
#
# Each task to run has to be defined through a single line
# indicating with different fields when the task will be run
# and what command to run for the task
#
# To define the time you can provide concrete values for
# minute (m), hour (h), day of month (dom), month (mon),
# and day of week (dow) or use '*' in these fields (for 'any').
#
# Notice that tasks will be started based on the cron's system
# daemon's notion of time and timezones.
#
# Output of the crontab jobs (including errors) is sent through
# email to the user the crontab file belongs to (unless redirected).
#
# For example, you can run a backup of all your user accounts
# at 5 a.m every week with:
# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/
#
# For more information see the manual pages of crontab(5) and cron(8)
#
# Every job needs the relocated pass/gnupg homes exported: cron's bare /bin/sh
# never reads ~/.config/zsh/.zshenv, so without these `pass` looks in the empty
# default ~/.password-store ("<entry> is not in the password store") and gpg in
# ~/.gnupg (pinentry "Inappropriate ioctl for device").
# m h  dom mon dow   command
*/10 * * * * /bin/sh -c 'export PASSWORD_STORE_DIR="$HOME/.local/share/pass" GNUPGHOME="$HOME/.local/share/gnupg"; mkdir -p "$HOME/.cache" "$HOME/.local/state" && /usr/bin/flock -xn "$HOME/.cache/ical2org.lock" -c "$HOME/.local/scripts/cal-sync-cron" >> "$HOME/.local/state/ical2org.log" 2>&1'
# The two mbsync jobs share one lock so they never write the maildir or the
# notmuch database concurrently; the hourly one uses -xn too, so it skips
# rather than queues if the 5-minute job is mid-sync, and retries next hour.
*/5 * * * * /bin/sh -c 'export PATH="$HOME/.local/bin:$PATH" PASSWORD_STORE_DIR="$HOME/.local/share/pass" GNUPGHOME="$HOME/.local/share/gnupg"; mkdir -p "$HOME/.cache/mbsync" "$HOME/.local/state" && /usr/bin/flock -xn "$HOME/.cache/mbsync/mbsync.lock" -c "$HOME/.local/bin/mbsync gmail-fast && $HOME/.local/scripts/notmuch-cron new" >> "$HOME/.local/state/mbsync.log" 2>&1'
23 * * * * /bin/sh -c 'export PATH="$HOME/.local/bin:$PATH" PASSWORD_STORE_DIR="$HOME/.local/share/pass" GNUPGHOME="$HOME/.local/share/gnupg"; mkdir -p "$HOME/.cache/mbsync" "$HOME/.local/state" && /usr/bin/flock -xn "$HOME/.cache/mbsync/mbsync.lock" -c "$HOME/.local/bin/mbsync gmail-archive && $HOME/.local/scripts/notmuch-cron new" >> "$HOME/.local/state/mbsync.log" 2>&1'
0 7 * * * /bin/sh -c 'export PASSWORD_STORE_DIR="$HOME/.local/share/pass" GNUPGHOME="$HOME/.local/share/gnupg"; mkdir -p "$HOME/.cache" "$HOME/.local/state" && /usr/bin/flock -xn "$HOME/.cache/rss2email.lock" -c "$HOME/.local/scripts/rss2email-cron run" >> "$HOME/.local/state/rss2email.log" 2>&1'
