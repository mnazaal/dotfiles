  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] || exit 0; out=$(\"$f\" 2>&1 >/dev/null); [ -n \"$out\" ] && printf '%s\\n' \"$out\"; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/sandbox\"; if [ -x \"$f\" ] && [ -e /run/.containerenv ]; then if ! out=$(\"$f\" -p agent-claude --verify-pins 2>&1); then printf '%s\\n' \"$out\"; printf '%s\\n' \"$out\" >&2; exit 1; fi; fi; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|WebFetch|Glob|Grep|Skill|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/guardrails.ts\"; if [ -f \"$f\" ] && bun \"$f\"; then exit 0; fi; printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"guardrail hook failed to run (missing bun, or policy JSON missing/malformed) — denied, fail closed; see stderr\"}}'"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.agents/skills/plan-interview/SKILL.md\"; command -v jq >/dev/null || exit 0; { [ -s \"$f\" ] && cat \"$f\" || printf '%s' 'Load the plan-interview skill and follow its Question Shape before asking.'; } | jq -Rs '{hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:(\"plan-interview skill (follow its Question Shape):\\n\"+.)}}'; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] || exit 0; out=$(\"$f\" 2>&1 >/dev/null); [ -n \"$out\" ] && { printf '%s\\n' \"$out\" >&2; exit 1; }; exit 0"
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "diffTool": "auto"
}
