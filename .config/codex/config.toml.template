# Codex CLI user config template.
#
# Codex may write machine-local trust/project state back into config.toml,
# including absolute paths. Do not stow this template as config.toml. Copy it to
# $CODEX_HOME/config.toml locally so Codex can mutate the copy without leaking
# host paths into dotfiles.

model = "gpt-5.6-terra"
model_instructions_file = "~/.agents/AGENTS.md"

# approval_policy governs escalation prompts for anything outside the active
# permissions profile's grants. Detailed command-level policy (dangerous
# commands, skill gates, machinery-write blocks with nuanced bash parsing)
# still lives in the shared ~/.agents/guardrails core and is enforced by
# hooks below - this stays the primary, most-capable enforcement layer.
#
# default_permissions below is a SECOND, OS-level (Landlock/seccomp on
# Linux) layer that duplicates only the credentials/machinery path lists
# from ~/.agents/guardrails/sensitive-paths.json, so a shell command that
# slips past the hook's text-based path matching still can't actually touch
# a denied path at the kernel level. See
# ~/.agents/guardrails/README.md "Native permission layers".
approval_policy = "on-request"
default_permissions = ":read-only"  # STEP B: flip to "guarded-workspace" only after verification in guardrails/README.md passes

# Custom filesystem permission profile. Hand-maintained duplicate of
# ~/.agents/guardrails/sensitive-paths.json (credentials -> deny, machinery ->
# read), drift-checked by `make check-guardrails-native-sync` (credentials and
# machinery both). It is dormant on hosts whose sandbox can't initialize — see
# guardrails/README.md "Native permission layers"; kept for portability to
# sandbox-capable hosts.
[permissions.guarded-workspace]
extends = ":workspace"

[permissions.guarded-workspace.filesystem]
# --- credentials (deny: read+write blocked) ---
"~/.aws" = "deny"
"~/.gnupg" = "deny"
"~/.gpg" = "deny"
"~/.ssh" = "deny"
"~/.config/git/credentials" = "deny"
"~/.netrc" = "deny"
"~/.npmrc" = "deny"
"~/.docker/config.json" = "deny"
"~/.kube/config" = "deny"
"~/.password-store" = "deny"
"~/.local/share/gnupg" = "deny"
"~/.local/share/pass" = "deny"
"~/.claude/.credentials.json" = "deny"
"~/.config/pi/agent/auth.json" = "deny"
"~/.pi/agent/auth.json" = "deny"
"~/.local/share/opencode/auth.json" = "deny"
"~/.config/codex/auth.json" = "deny"

# --- machinery (read: write blocked, read allowed) ---
"~/.bashrc" = "read"
"~/dotfiles/.bashrc" = "read"
"~/.bash_profile" = "read"
"~/dotfiles/.bash_profile" = "read"
"~/.profile" = "read"
"~/.zshenv" = "read"
"~/dotfiles/.zshenv" = "read"
"~/.zshrc" = "read"
"~/.zprofile" = "read"
"~/.config/zsh" = "read"
"~/dotfiles/.config/zsh" = "read"
"~/.config/sandbox" = "read"
"~/dotfiles/.config/sandbox" = "read"
"~/.config/renv" = "read"
"~/dotfiles/.config/renv" = "read"
"~/.config/git/hooks" = "read"
"~/dotfiles/.config/git/hooks" = "read"
"~/.local/scripts" = "read"
"~/dotfiles/.local/scripts" = "read"
"~/dotfiles/.local/share/gnupg/gpg-agent.conf" = "read"
"~/.claude/hooks" = "read"
"~/dotfiles/.claude/hooks" = "read"
"~/.claude/settings.json" = "read"
"~/dotfiles/.claude/settings.json" = "read"
"~/.config/pi/agent/extensions" = "read"
"~/dotfiles/.config/pi/agent/extensions" = "read"
"~/.config/pi/agent/settings.json" = "read"
"~/dotfiles/.config/pi/agent/settings.json" = "read"
"~/.config/opencode/opencode.jsonc" = "read"
"~/dotfiles/.config/opencode/opencode.jsonc" = "read"
"~/.config/opencode/plugins" = "read"
"~/dotfiles/.config/opencode/plugins" = "read"
"~/.config/codex/hooks" = "read"
"~/dotfiles/.config/codex/hooks" = "read"
"~/.config/codex/config.toml" = "read"
"~/.config/codex/hooks.json" = "read"
"~/dotfiles/.config/codex/hooks.json" = "read"
"~/.config/codex/config.toml.template" = "read"
"~/dotfiles/.config/codex/config.toml.template" = "read"
"~/.config/goose" = "read"
"~/dotfiles/.config/goose" = "read"
"~/.agents/guardrails" = "read"
"~/dotfiles/.agents/guardrails" = "read"

hide_agent_reasoning = true
web_search = "cached"

[features]
hooks = true
multi_agent = true
shell_tool = true
skill_mcp_dependency_install = false

[history]
persistence = "save-all"
max_bytes = 10485760

[mcp_servers.deepwiki]
url = "https://mcp.deepwiki.com/mcp"
enabled = true
required = false
startup_timeout_sec = 10
tool_timeout_sec = 60

[mcp_servers.grepika]
command = "bunx"
args = ["-y", "@agentika/grepika", "--mcp"]
enabled = true
required = false
startup_timeout_sec = 10
tool_timeout_sec = 60

[mcp_servers.playwright]
command = "bunx"
args = ["-y", "@playwright/mcp@latest"]
enabled = false
required = false
startup_timeout_sec = 10
tool_timeout_sec = 60

[mcp_servers.asta-mcp]
url = "https://asta-tools.allen.ai/mcp/v1"
env_http_headers = { "x-api-key" = "ASTA_MCP_API_KEY" }
enabled = true
required = false
startup_timeout_sec = 10
tool_timeout_sec = 60

[mcp_servers.headroom]
command = "headroom"
args = ["mcp", "serve"]
enabled = false
required = false
startup_timeout_sec = 10
tool_timeout_sec = 60
