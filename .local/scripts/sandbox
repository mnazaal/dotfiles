#!/usr/bin/env bash
# sandbox — run a command confined to an allowlist of directories.
# Backends share one profile/allowlist front-end:
#   gvisor           — rootless container via the runsc user-space kernel
#   podman (default) — rootless container on the default runtime (no runsc)
# A profile's allowlist becomes -v mounts; everything else under $HOME stays
# invisible. See `sandbox --help`.
set -euo pipefail

H=$HOME
BACKEND=${SANDBOX_BACKEND:-podman}
PROFILE_PATH=${SANDBOX_PROFILE_PATH:-${XDG_CONFIG_HOME:-$H/.config}/sandbox}
IMAGE=${SANDBOX_IMAGE:-ubuntu:24.04}

die() {
	printf 'sandbox: %s\n' "$1" >&2
	exit "${2:-1}"
}

show_help() {
	cat <<'EOF'
sandbox — run a command confined to an allowlist of directories

USAGE
  sandbox [options] [--] <command> [args...]
  sandbox --help

OPTIONS
  -p, --profile NAME|PATH   load a profile; a bare NAME resolves against
                            $SANDBOX_PROFILE_PATH (default ~/.config/sandbox),
                            a value containing '/' is a file path. Repeatable;
                            a profile may `use OTHER` to compose.
      --rw DIR              add a read-write bind        (repeatable)
      --ro DIR              add a read-only  bind        (repeatable)
      --backend NAME        gvisor | podman (default); or $SANDBOX_BACKEND
      --no-net              unshare the network (shared by default)
  -n, --dry-run             print the backend command instead of running it
      --verify-pins         inside the sandbox: check every machinery pin is
                            actually read-only, then exit. Non-zero if any is not
  -h, --help                show this help

DESCRIPTION
  Only an allowlist is visible: the current project ($PWD) is read-write,
  system dirs and whatever profiles add are read-only, everything else under
  $HOME (ssh, gnupg, pass, other projects) is invisible. Secrets already in
  the environment pass through, so callers can resolve them beforehand.

  Backends: `gvisor` runs the command in a rootless container via the
  runsc runtime — a user-space kernel that shrinks the host kernel attack surface
  (needs `runsc` on PATH; no root/KVM). `podman` is the same container on the
  default runtime (no runsc). Env: $SANDBOX_BACKEND, $SANDBOX_IMAGE (container
  base image), $SANDBOX_PROFILE_PATH.
EOF
}

# --- profile loading ---------------------------------------------------------

find_profile() { # NAME -> path on $PROFILE_PATH, or fail
	local name=$1 dir
	local IFS=:
	for dir in $PROFILE_PATH; do
		if [ -f "$dir/$name.profile" ]; then
			printf '%s' "$dir/$name.profile"
			return 0
		fi
	done
	return 1
}

# `use NAME` — compose another profile by name (include-guarded). For profiles.
use() {
	local name=$1 f
	[ -z "${_loaded[$name]:-}" ] || return 0
	_loaded[$name]=1
	f=$(find_profile "$name") || die "profile not found: $name (searched: $PROFILE_PATH)"
	# shellcheck source=/dev/null
	. "$f"
}

load_profile_arg() { # -p value: a path (has '/') or a name on the search path
	case "$1" in
	*/*)
		[ -f "$1" ] || die "profile file not found: $1"
		# shellcheck source=/dev/null
		. "$1"
		;;
	*) use "$1" ;;
	esac
}

# --- backends ----------------------------------------------------------------

run_podman() {
	command -v podman >/dev/null 2>&1 || die 'podman not found in PATH' 127
	local d
	local pre=() # podman global flags (must precede `run`)
	local name="${PROFILE_NAME:-sandbox}-$$"
	local p=(run --rm --name "$name" --userns=keep-id --http-proxy=false -w "$PWD" --security-opt label=disable)
	# Pass the NAME only: podman reads the value from this process's environment
	# and sets it in the container just when it is set here. Emitting "$d=$value"
	# instead would put every allowlisted secret into the podman argv, where it is
	# world-readable via `ps` for the life of the container and printed verbatim
	# by --dry-run.
	for d in "${SANDBOX_ENV[@]}"; do
		[ -n "${!d+x}" ] && p+=(--env "$d")
	done
	# Give commands normal scratch space without exposing the host's /tmp.
	# shellcheck disable=SC2054  # commas are mount options within one element
	p+=(--tmpfs /tmp:rw,nosuid,nodev,mode=1777)
	if [ -n "$PODMAN_RUNTIME" ]; then
		# gvisor (runsc): select the runtime and tell it to ignore cgroups (it
		# cannot set them up rootlessly). When networking is on, use the host
		# network stack instead of gVisor's netstack, which doesn't implement
		# every socket op (else apps hit FailedToOpenSocket / DNS failures).
		pre+=(--runtime "$PODMAN_RUNTIME" --runtime-flag=ignore-cgroups)
		[ "$NET" -eq 1 ] && pre+=(--runtime-flag=network=host)
	fi
	if [ -t 0 ] && [ -t 1 ]; then p+=(-it); else p+=(-i); fi
	if [ "$NET" -eq 1 ]; then p+=(--network=host); else p+=(--network=none); fi
	[ -n "$SANDBOX_PATH_PREPEND" ] && p+=(--env "PATH=$SANDBOX_PATH_PREPEND:$PATH")

	# Reuse the host userspace (binaries + libs) + TLS certs, read-only, so the
	# command sees the same tools it would natively. The image supplies /etc
	# (resolv.conf, hosts) that podman manages.
	for d in /usr /opt /etc/ssl /etc/ca-certificates; do
		if [ -e "$d" ]; then p+=(-v "$d:$d:ro"); fi
	done
	for d in "${RO[@]}"; do if [ -e "$d" ]; then p+=(-v "$d:$d:ro"); fi; done
	for d in "${RW[@]}"; do if [ -e "$d" ]; then p+=(-v "$d:$d"); fi; done
	for d in "${RW_FILES[@]}"; do if [ -e "$d" ]; then p+=(-v "$d:$d"); fi; done
	for d in "${RO_LAST[@]}"; do if [ -e "$d" ]; then p+=(-v "$d:$d:ro"); fi; done

	# Fail closed: assert every pin is genuinely read-only INSIDE the container
	# before the sandboxed command gets control. Emitting the -v above is a
	# request; this is the only place the kernel's answer is read. `test -w`
	# reports false on a read-only bind for both files and directories, so no
	# mountinfo parsing is needed.
	local pins=() d
	for d in "${RO_LAST[@]}"; do
		if [ -e "$d" ]; then pins+=("$d"); fi
	done
	# Two counts, because a pin that VANISHED and a pin that is WRITABLE are
	# different failures. Passing only the surviving count would let a missing
	# pin shrink the denominator and report success on a smaller set than was
	# declared, which is the fail-open this whole check exists to remove.
	local preflight='declared=$1; n=$2; shift 2
if [ "$n" -ne "$declared" ]; then
	printf "sandbox: %s of %s machinery pins are missing from the container and are unprotected\n" \
		"$((declared - n))" "$declared" >&2
	printf "sandbox: continuing — a declared pin whose file does not exist cannot be enforced\n" >&2
fi
while [ "$n" -gt 0 ]; do
	if [ -w "$1" ]; then
		printf "sandbox: FATAL machinery pin is writable, so it is not enforced: %s\n" "$1" >&2
		printf "sandbox: refusing to start.\n" >&2
		exit 78
	fi
	shift
	n=$((n - 1))
done
exec "$@"'

	if [ "$DRYRUN" -eq 1 ]; then
		printf 'podman'
		printf ' %q' "${pre[@]}" "${p[@]}" "$IMAGE" \
			/bin/sh -c "$preflight" sandbox-preflight "${#RO_LAST[@]}" "${#pins[@]}" "${pins[@]}" "${cmd[@]}"
		printf '\n'
		exit 0
	fi
	exec podman "${pre[@]}" "${p[@]}" "$IMAGE" \
		/bin/sh -c "$preflight" sandbox-preflight "${#RO_LAST[@]}" "${#pins[@]}" "${pins[@]}" "${cmd[@]}"
}

# --- run ---------------------------------------------------------------------

# accumulators — profiles and flags append to these
# RO_LAST is emitted AFTER every RW bind, so a read-only path nested inside a
# writable one stays read-only. Plain RO is emitted first, where an overlapping
# RW bind wins — which is why the read-only $H/.agents bind does not protect
# its stow targets under the writable $H/dotfiles bind.
declare -a RW=() RO=() RW_FILES=() RO_LAST=()
# Only these non-secret host variables cross the sandbox boundary by default.
# Profiles append the minimal harness-specific variables (including any required
# launch-time credential) to SANDBOX_ENV.
declare -a SANDBOX_ENV=(HOME PWD PATH LANG LC_ALL LC_CTYPE TERM COLORTERM NO_COLOR EDITOR VISUAL XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_RUNTIME_DIR XDG_STATE_HOME WAYLAND_DISPLAY)
NET=1 # 1 share network, 0 unshare
DRYRUN=0
VERIFY_PINS=0
SANDBOX_PATH_PREPEND=""
PODMAN_RUNTIME="" # gvisor backend sets this to the runsc path
PROFILE_NAME=""   # first -p name, used as podman container name
declare -A _loaded=()

cmd=()
while [ $# -gt 0 ]; do
	case "$1" in
	-p | --profile)
		load_profile_arg "$2"
		[ -z "$PROFILE_NAME" ] && PROFILE_NAME="${2##*/}" # first -p sets the name
		shift 2
		;;
	--rw)
		RW+=("$2")
		shift 2
		;;
	--ro)
		RO+=("$2")
		shift 2
		;;
	--backend)
		BACKEND=$2
		shift 2
		;;
	--no-net)
		NET=0
		shift
		;;
	-n | --dry-run)
		DRYRUN=1
		shift
		;;
	--verify-pins)
		VERIFY_PINS=1
		shift
		;;
	-h | --help)
		show_help
		exit 0
		;;
	--)
		shift
		cmd=("$@")
		break
		;;
	-*) die "unknown option: $1" ;;
	*)
		cmd=("$@")
		break
		;;
	esac
done

[ ${#cmd[@]} -gt 0 ] || [ "$VERIFY_PINS" -eq 1 ] ||
	die 'usage: sandbox [options] [--] <command> [args...]' 2

# A read-only bind is attached to an inode, so replacing the file orphans the
# mount and silently disarms the pin for the life of the session — and replacing
# is what `git checkout`, stow and every temp-then-rename editor write does. The
# profile and the backend argv both still look correct afterwards, which is why
# comparing those two (`make check-machinery-ro-sync`) cannot detect it. Only the
# live mount namespace can, so ask it.
if [ "$VERIFY_PINS" -eq 1 ]; then
	[ -e /run/.containerenv ] || [ -e /.dockerenv ] ||
		die '--verify-pins is meaningful only inside the sandbox' 2
	pin_status=0
	pin_checked=0
	pin_writable=0
	pin_missing=0
	for d in "${RO_LAST[@]}"; do
		if [ ! -e "$d" ]; then
			printf 'sandbox: machinery pin MISSING, so unprotected: %s\n' "$d" >&2
			pin_missing=$((pin_missing + 1))
			pin_status=1
			continue
		fi
		pin_checked=$((pin_checked + 1))
		if [ -w "$d" ]; then
			printf 'sandbox: machinery pin WRITABLE, so not enforced: %s\n' "$d" >&2
			pin_writable=$((pin_writable + 1))
			pin_status=1
		fi
	done
	if [ "${#RO_LAST[@]}" -eq 0 ]; then
		printf 'sandbox: no machinery pins declared — the profile did not compose\n' >&2
		exit 1
	fi
	if [ "$pin_status" -eq 0 ]; then
		# Says what was measured, not what was hoped. `test -w` answers "not
		# writable from here", which for a pin nested under a read-only parent
		# bind is also true when the pin's own bind is absent — so this counts
		# non-writable paths, and only a session whose cwd makes the parent
		# writable distinguishes the two.
		printf 'sandbox: %d of %d machinery pins present and not writable\n' \
			"$pin_checked" "${#RO_LAST[@]}"
	else
		# Different causes, different remedies. A writable pin means its bind was
		# orphaned by the file being replaced, which a relaunch fixes. A missing
		# pin means policy names a path that is not there, which a relaunch
		# cannot fix and which needs the profile or the file reconciled.
		if [ "$pin_writable" -gt 0 ]; then
			printf 'sandbox: relaunch to re-bind — a pin breaks when its file is replaced.\n' >&2
		fi
		if [ "$pin_missing" -gt 0 ]; then
			printf 'sandbox: a missing pin is not fixed by relaunching; reconcile the profile with the filesystem.\n' >&2
		fi
	fi
	exit "$pin_status"
fi

cmdpath=$(command -v -- "${cmd[0]}") || die "command not found: ${cmd[0]}" 127
cmd[0]=$cmdpath

realhome=$(readlink -f "$H")
realcwd=$(readlink -f "$PWD")
is_home_or_ancestor() {
	case "$realhome/" in "$1"/*) return 0 ;; esac
	return 1
}

# Reject binds that would re-expose all of $HOME or /, including ancestors of
# $HOME such as /home. Such a bind defeats the allowlist just as completely.
for d in "${RW[@]}" "${RO[@]}" "${RO_LAST[@]}"; do
	rd=$(readlink -f "$d" 2>/dev/null || printf '%s' "$d")
	if [ "$rd" = "/" ] || is_home_or_ancestor "$rd"; then
		die "refusing to bind '$d' — it re-exposes all of \$HOME or /"
	fi
done

# auto-bind cwd read-write — but never when it is $HOME or above
if [ "$realcwd" = "$realhome" ] || is_home_or_ancestor "$realcwd"; then
	printf 'sandbox: cwd (%s) is $HOME or above — not auto-binding it.\n' "$PWD" >&2
	printf '         cd into a project, or pass --rw DIR explicitly.\n' >&2
	[ ${#RW[@]} -gt 0 ] || die 'empty writable allowlist from $HOME — refusing to run'
else
	RW+=("$PWD")
fi

# Dedupe mount destinations: a path can be bound only once, else podman/gvisor
# fail with "duplicate mount destination" (e.g. cwd is a dir a profile also
# RO-mounts, like running from ~/dotfiles). RW is deduped first so it wins over
# RO — the current project / explicit --rw stays writable.
_rp() { readlink -f "$1" 2>/dev/null || printf '%s' "$1"; }
declare -A _seen=()
dedupe() { # $1 = array name; drop entries whose realpath already appeared
	local -n _a=$1
	local out=() x k
	for x in "${_a[@]}"; do
		k=$(_rp "$x")
		[ -z "${_seen[$k]:-}" ] || continue
		_seen[$k]=1
		out+=("$x")
	done
	_a=("${out[@]}")
}
dedupe RW
dedupe RW_FILES
dedupe RO
dedupe RO_LAST

# Profiles are trusted shell snippets, but environment names still need to be
# valid before indirect expansion below.
declare -A _seen_env=()
env_out=()
for name in "${SANDBOX_ENV[@]}"; do
	[[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid sandbox environment name: $name"
	[ -z "${_seen_env[$name]:-}" ] || continue
	_seen_env[$name]=1
	env_out+=("$name")
done
SANDBOX_ENV=("${env_out[@]}")

case "$BACKEND" in
podman) run_podman ;;
gvisor)
	PODMAN_RUNTIME=$(command -v runsc) ||
		die "gvisor backend needs 'runsc' (gVisor) on PATH — install it (no root/KVM): https://gvisor.dev/docs/user_guide/install/"
	run_podman
	;;
*) die "unknown backend: $BACKEND   (known: podman, gvisor)" ;;
esac
