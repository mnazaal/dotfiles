{
  "_comment": "Path guardrails. Single source of truth consumed by the shared core (~/.agents/guardrails/core.ts), used by Claude and pi via their adapters. Paths only, no logic. See README.md. Credentials are blocked for read/write/bash. Machinery is blocked for write/bash but allowed for normal read tools, so agents can inspect their own guardrails without gaining persistence-edit access. `machinery_enabled` is per-agent and should only be disabled while bootstrapping.",
  "credentials": [
    "~/.aws",
    "~/.gnupg",
    "~/.gpg",
    "~/.ssh",
    "~/.config/git/credentials",
    "~/.netrc",
    "~/.npmrc",
    "~/.docker/config.json",
    "~/.kube/config",
    "~/.password-store",
    "~/.local/share/gnupg",
    "~/.local/share/pass",
    "~/.claude/.credentials.json",
    "~/.config/pi/agent/auth.json"
  ],
  "sensitive_segments": [
    ".ssh",
    ".gnupg",
    ".gpg",
    ".aws",
    ".password-store"
  ],
  "protected_write_globs": [
    "**/*.tex"
  ],
  "machinery_enabled": {
    "claude": true,
    "pi": true
  },
  "machinery": [
    "~/.bashrc",
    "~/dotfiles/.bashrc",
    "~/.bash_profile",
    "~/dotfiles/.bash_profile",
    "~/.zshenv",
    "~/dotfiles/.zshenv",
    "~/.config/zsh",
    "~/dotfiles/.config/zsh",
    "~/.config/sandbox",
    "~/dotfiles/.config/sandbox",
    "~/.config/renv",
    "~/dotfiles/.config/renv",
    "~/.config/git/hooks",
    "~/dotfiles/.config/git/hooks",
    "~/.local/scripts",
    "~/dotfiles/.local/scripts",
    "~/dotfiles/.local/share/gnupg/gpg-agent.conf",
    "~/.claude/hooks",
    "~/dotfiles/.claude/hooks",
    "~/.claude/settings.json",
    "~/dotfiles/.claude/settings.json",
    "~/.config/pi/agent/extensions",
    "~/dotfiles/.config/pi/agent/extensions",
    "~/.config/pi/agent/settings.json",
    "~/dotfiles/.config/pi/agent/settings.json",
    "~/.agents/guardrails",
    "~/dotfiles/.agents/guardrails"
  ]
}
