{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": "notify",

    "default_agent": "plan",
    "model": "openai/gpt-5.5",
    "small_model": "opencode-go/kimi-k2.5",
    "instructions": ["AGENTS.md"],

    "provider": {
        "openrouter": {
            "models": {
                "deepseek/deepseek-v4-pro": {
                    "options": {
                        "provider": {
                            "order": ["DeepSeek"],
                            "allow_fallbacks": false
                        }
                    }
                }
            }
        },
        "openai": {
            "models": {
                "gpt-5.5": {
                    "options": {
                        "reasoningEffort": "low"
                    }
                }
            }
        }
    },

    // MCP servers for external tools and data sources.
    "mcp": {
        // Documentation lookup.
        "deepwiki": {
            "type": "remote",
            "url": "https://mcp.deepwiki.com/mcp",
            "enabled": true
        },
        // Faster code search.
        "grepika": {
            "type": "local",
            "command": ["bunx", "-y", "@agentika/grepika", "--mcp"],
            "enabled": true
        },
        // Browser automation.
        "playwright": {
            "type": "local",
            "command": ["bunx", "-y", "@playwright/mcp@latest"],
            "enabled": false
        },
        "asta-mcp": {
            "type": "remote",
            "url": "https://asta-tools.allen.ai/mcp/v1",
            "headers": {
                "x-api-key": "{env:ASTA_MCP_API_KEY}"
            },
            "enabled": true
        },
        // Context compression: compress tool outputs, logs, files
        // LLM calls headroom_compress / headroom_retrieve / headroom_stats
        "headroom": {
            "type": "local",
            "command": ["headroom", "mcp", "serve"],
            "enabled": false
        }
    },

    "watcher": {
        "ignore": [
            ".git/**",
            ".venv/**",
            "target/**",
            ".cache/**",
            ".pytest_cache/**",
            "coverage/**",
            "__pycache__/**",
            "node_modules/**",
            "dist/**",
            ".ipynb_checkpoints/**",
            ".ruff_cache/**",
            ".mypy_cache/**"
        ]
    },

    // Permission rules control which operations require confirmation.
    "permission": {
        // In-repo secrets + noise only. Host-level credentials (~/.ssh, ~/.aws,
        // auth.json, shell rc files, ...) are NOT duplicated here: plugins/guardrails.ts
        // enforces them from the shared core (verified loading + blocking) and also
        // covers bash, which a static read-list cannot. "*" allow must come first.
        "read": {
            "*": "allow",
            "**/.env": "deny",
            "**/.env.*": "deny",
            "**/.git/**": "deny",
            "**/node_modules/**": "deny"
        },
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "ask",
        "bash": {
            "*": "ask",

            "bash -n *": "allow",

            "ls": "allow",
            "ls *": "allow",

            "echo *": "allow",

            "head": "allow",
            "head *": "allow",

            "tail": "allow",
            "tail *": "allow",

            "pwd": "allow",

            "wc": "allow",
            "wc *": "allow",

            "ruff": "allow",
            "ruff *": "allow",

            "pytest": "allow",
            "pytest *": "allow",

            "python -m pytest": "deny",
            "python -m pytest *": "deny",

            "uv run pytest": "deny",
            "uv run pytest *": "deny",

            "pyright": "allow",
            "pyright *": "allow",

            "python -m pyright": "deny",
            "python -m pyright *": "deny",

            "uv run pyright": "deny",
            "uv run pyright *": "deny",

            "rg": "deny",
            "rg *": "deny",

            "grep": "deny",
            "grep *": "deny",

            "find": "allow",
            "find *": "allow",

            "sort": "allow",
            "sort *": "allow",

            // git: allowlist of safe ops (read-only + add/commit/stash/branch);
            // everything else — push, checkout, switch, merge, fetch, pull, reset,
            // rebase, … — falls through to the "*": "ask" default. Mirrors claude's
            // settings.json git policy (allow-list, not allow-by-default). Destructive
            // subcommands of an allowed verb stay explicit "ask" below so they prompt.
            "git status": "allow",
            "git status *": "allow",
            "git diff": "allow",
            "git diff *": "allow",
            "git log": "allow",
            "git log *": "allow",
            "git show": "allow",
            "git show *": "allow",
            "git branch": "allow",
            "git branch *": "allow",
            "git add": "allow",
            "git add *": "allow",
            "git commit": "allow",
            "git commit *": "allow",
            "git stash": "allow",
            "git stash *": "allow",

            "git push": "ask",
            "git push *": "ask",

            "git clean *": "ask",

            "git reset --hard *": "ask",

            "git push --force *": "ask",

            "git push -f *": "ask",

            "git branch -D *": "ask",

            "git rebase *": "ask",

            "git cherry-pick *": "ask",

            "git restore *": "ask",

            "git checkout -- *": "ask",

            "git tag -d *": "ask",

            "git stash drop *": "ask",

            "git stash clear": "ask",

            // Branch-confinement + ref-write guards (GIT_CONFIG_* injection,
            // `git -ccore.hooksPath`, `--no-verify`, forced branch moves) are enforced
            // by plugins/guardrails.ts from the shared core, which catches cases these
            // globs can't. Not duplicated here.
        },
        "task": { "*": "deny" },
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "deny",
        "todowrite": "deny",
        "todoread": "deny",
        "skill": "allow"
    },
    "plugin": ["@tarquinen/opencode-dcp@latest"]
}
