#!/usr/bin/env bash
# agent-checkpoint — snapshot the working tree to
# refs/agent-checkpoint/<prefix>/<epoch>.
#
# Harness-agnostic: invoked by whatever per-turn hook each agent provides. It
# exists so the shared guardrail `ask` tier can be empty — allow-all rests on
# "git makes writes recoverable", but git only protects COMMITTED work. This
# captures uncommitted and untracked work too.
#
# Refs are namespaced by AGENT_BRANCH_PREFIX, the convention the shared git
# hooks already use, so two agents in one repo never collide.
#
# Uses a temporary index, not `git stash create`, which silently omits untracked
# files. The real index, working tree, HEAD, and stash stack are never touched.
# Exit status IS the contract, because a caller has to tell "no snapshot" from
# "snapshot taken, filed oddly": nonzero means a snapshot was attempted and the
# work is NOT captured. Zero means no snapshot was NEEDED or one was taken.
# Callers that gate on this script (the per-Bash hook) block only on nonzero.
# Keying on stderr instead conflates the two and blocks on success.
#
# Outside a repository there is nowhere to snapshot into, and that path exits 0
# SILENTLY and deliberately (test case 1): the per-turn hook prints stderr into
# every turn, and ~/org, ~/.cache and ~/.local/share are non-repos worked in
# daily, so a message there is a banner on every turn rather than information.
# Whether destructive commands should be allowed where there is no recovery at
# all is a POLICY question for dangerous-commands.json, not one this script can
# answer.
set -uo pipefail

# The guardrail `allow` tier for world-writable and recursive-force-rm is earned
# by this script working, so a checkpoint that stops working must say so where
# the turn can see it. Two severities, because they are not the same event:
#
#   fatal — nothing was captured. Exit 1, and a gating caller should refuse the
#           turn: allow-all rests on a snapshot that does not exist.
#   note  — the snapshot EXISTS but something about filing it is off. Exit 0:
#           the work is recoverable, so wedging the session buys nothing.
fatal() {
	printf 'agent-checkpoint: %s: uncommitted work is NOT recoverable this turn\n' \
		"$1" >&2
	exit 1
}

note() {
	printf 'agent-checkpoint: %s\n' "$1" >&2
	exit 0
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

# A failing `git status` is NOT a clean tree. Discarding its status made the two
# indistinguishable, so a held index.lock, an unreadable index or an ownership
# refusal all reported "nothing to snapshot" and returned success.
if ! status=$(git status --porcelain 2>/dev/null); then
	fatal "could not read the working tree (git status failed)"
fi
[ -n "$status" ] || exit 0

# An unborn HEAD (a repo with no commits yet) has no tree to read and no commit
# to point at. That is where work is LEAST recoverable, so snapshot it anyway,
# parentless, instead of falling through to the silent no-op below.
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
	parent=(-p HEAD)
else
	parent=()
fi

idx=$(mktemp -u 2>/dev/null) || fatal "could not create a temporary index"
addfail="$idx.addfail"
adderr="$idx.adderr"
top=$(git rev-parse --show-toplevel 2>/dev/null) || fatal "could not find the repository root"
tree=$(
	export GIT_INDEX_FILE="$idx"
	if [ ${#parent[@]} -gt 0 ]; then
		git read-tree HEAD 2>/dev/null || exit 1
	fi
	# --ignore-errors, because a path that cannot be indexed must not cost us the
	# whole snapshot. The harness masks its own denied paths as /dev/null
	# character devices at the root of EVERY project it opens, and `git add`
	# refuses those ("can only add regular files, symbolic links or
	# git-directories") — without this flag the mask defeats the checkpoint in
	# every repo, and a caller gating on that blocks the session outright. The
	# read-tree above already put the committed version of any masked-but-tracked
	# file in the index, so those keep their HEAD content rather than vanishing.
	#
	# The status still matters, so it is recorded beside the index rather than
	# mixed into this capture, which carries the tree sha alone. The stderr is
	# kept too: what `git add` refused decides below whether an unchanged tree is
	# a clean tree or a failed capture.
	git add -A --ignore-errors 2>"$adderr" || : >"$addfail"
	# The same masks reach the HOST as ordinary files. A bind mount needs a
	# mount point, so the harness creates one, and a killed session leaves them
	# behind: zero-byte, mode 444, at every path it masked (root dotfiles and
	# .claude/*). The per-turn hooks run on the host, so the next checkpoint sees
	# regular empty files that `git add` does NOT refuse — a tracked path is
	# indexed as an empty blob over its committed content, and every untracked
	# mask becomes a phantom empty file (observed: 22 empty blobs in one
	# snapshot). Put the committed content back for tracked ones and drop the
	# rest. The signature is 0 bytes AND not user-writable; an empty file the
	# agent created is user-writable and is captured like any other. Depth 2
	# covers where masks land (<root>/<name> and <root>/.claude/<name>) without
	# walking a large tree on every turn.
	find "$top" -maxdepth 2 -type f -size 0 ! -perm -u+w -not -path "$top/.git/*" -print0 2>/dev/null |
		while IFS= read -r -d '' p; do
			rel=${p#"$top"/}
			if git -C "$top" cat-file -e "HEAD:$rel" 2>/dev/null; then
				git -C "$top" reset -q -- "$rel" 2>/dev/null
			else
				git -C "$top" rm -q --cached --ignore-unmatch -- "$rel" 2>/dev/null
			fi
		done
	git write-tree 2>/dev/null || exit 1
)
rm -f "$idx" 2>/dev/null || true
add_failed=0
[ -e "$addfail" ] && add_failed=1
rm -f "$addfail" 2>/dev/null || true
# Did `git add` refuse ONLY unindexable nodes (the harness masks)? That is the
# one refusal that never loses work: a device node holds nothing to capture.
# Anything else on stderr — an unreadable file, a broken index — is a path whose
# content is missing from the snapshot.
masks_only=0
if [ "$add_failed" -eq 1 ] && [ -s "$adderr" ] &&
	! grep -qv 'can only add regular files, symbolic links or git-directories' "$adderr"; then
	masks_only=1
fi
rm -f "$adderr" 2>/dev/null || true
[ -n "$tree" ] || fatal "could not write a tree (unreadable or unwritable repo?)"

# A tree equal to HEAD's holds nothing new. Two very different reasons get here,
# and the exit status has to tell them apart because the per-Bash hook gates on
# it. If `git add` failed on a real path -- an unreadable file, say -- the tree
# is byte-identical to the last commit while the turn's work sits uncaptured:
# that is the fatal case, and the discriminator is the tree, not the exit
# status. If it refused only masks, or refused nothing, the working tree IS
# clean apart from the harness's own nodes: `git status` lists those, so the
# clean-tree exit above never fires inside the boundary, and this is where a
# clean tree in a sandboxed repo has to be recognised as one. Before this,
# every Bash call in a clean repo was refused as "could not index".
if [ ${#parent[@]} -gt 0 ] &&
	[ "$tree" = "$(git rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null)" ]; then
	if [ "$add_failed" -eq 1 ] && [ "$masks_only" -eq 0 ]; then
		fatal "could not index the working tree (the snapshot would hold nothing new)"
	fi
	exit 0
fi

# Nothing changed since this agent's last checkpoint: the newest ref already
# holds this exact tree. Skip it. Measured on the real repo before this guard,
# 241 refs held only 114 distinct trees — turns that read, answer, or fail leave
# the tree identical, so without this the trail counts turns instead of states.
# Per agent, not global: two harnesses in one repo each keep their own trail.
prefix="refs/agent-checkpoint/${AGENT_BRANCH_PREFIX:-agent}"
last=$(git for-each-ref --sort=-refname --count=1 --format='%(objectname)' \
	"$prefix/" 2>/dev/null)
if [ -n "$last" ] && [ "$(git rev-parse -q --verify "$last^{tree}" 2>/dev/null)" = "$tree" ]; then
	exit 0
fi

sha=$(git commit-tree "$tree" "${parent[@]}" -m "agent checkpoint $(date -u +%FT%TZ)" 2>/dev/null) ||
	fatal "could not commit the snapshot tree"
[ -n "$sha" ] || fatal "commit-tree produced no object"

# Nanoseconds, not seconds: at second resolution two snapshots inside one
# second landed on the same ref name and the later one silently overwrote the
# earlier. %N is zero-padded to a fixed 9 digits, so refs keep sorting
# lexicographically in chronological order — including against the shorter
# second-resolution names written before this change.
git update-ref "$prefix/$(date +%s%N)" "$sha" 2>/dev/null ||
	# The commit object IS written at this point; only the ref failed. It is
	# dangling, so name it — `git fsck --lost-found` finds it until gc runs.
	# A note, not a fatal: the snapshot exists and the work is recoverable, so
	# there is nothing here worth refusing the turn over.
	note "could not update the checkpoint ref; snapshot is dangling at $sha"

printf 'checkpoint %s\n' "$sha"
exit 0
