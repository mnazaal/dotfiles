{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(~/projects/**)",
      "Edit(/tmp/**)",
      "WebSearch",
      "WebFetch",
      "mcp__asta-mcp",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(cat:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(pyright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.gpg/**)",
      "Read(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.password-store/**)",
      "Read(~/.local/share/gnupg/**)",
      "Read(~/.local/share/pass/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/pi/agent/auth.json)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.config/codex/auth.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(./.env)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zshenv)",
      "Edit(~/.config/zsh/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.config/pi/agent/auth.json)",
      "Edit(~/.local/share/opencode/auth.json)",
      "Edit(~/.config/codex/auth.json)",
      "Edit(~/.gpg/**)",
      "Edit(~/.config/git/credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/config)",
      "Edit(~/.password-store/**)",
      "Edit(./.env.*)",
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] && \"$f\" >/dev/null 2>&1; exit 0"
          },
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/sandbox\"; if [ -x \"$f\" ] && [ -e /run/.containerenv ]; then if ! out=$(\"$f\" -p agent-claude --verify-pins 2>&1); then printf '%s\\n' \"$out\"; printf '%s\\n' \"$out\" >&2; exit 1; fi; fi; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|WebFetch|Glob|Grep|Skill|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/guardrails.ts\"; if [ -f \"$f\" ] && bun \"$f\"; then exit 0; fi; printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Claude guardrail hook unavailable; confirm manually\"}}'"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.agents/skills/plan-interview/SKILL.md\"; command -v jq >/dev/null || exit 0; { [ -s \"$f\" ] && cat \"$f\" || printf '%s' 'Load the plan-interview skill and follow its Question Shape before asking.'; } | jq -Rs '{hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:(\"plan-interview skill (follow its Question Shape):\\n\"+.)}}'; exit 0"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "diffTool": "auto",
  "disableAgentView": true
}
