{
  "cleanupPeriodDays": 3650,
  "env": {
    "AGENT_BRANCH_PREFIX": "claude",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(~/projects/**)",
      "Edit(/tmp/**)",
      "WebSearch",
      "WebFetch",
      "mcp__asta-mcp",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(cat:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(pyright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.gpg/**)",
      "Read(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.password-store/**)",
      "Read(~/.local/share/gnupg/**)",
      "Read(~/.local/share/pass/**)",
      "Read(./.env)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/pi/agent/auth.json)",
      "Read(~/.config/onedrive/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.local/share/mail/**)",
      "Read(~/.git-credentials)",
      "Read(~/.git-credential-cache/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.local/share/password-store/**)",
      "Read(~/.zsh_history/**)",
      "Read(~/.local/share/zsh/**)",
      "Read(~/.viminfo/**)",
      "Read(~/.lesshst/**)",
      "Read(~/Dropbox/.dropbox/**)",
      "Read(~/Dropbox/.dropbox.cache)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(./.env)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zshenv)",
      "Edit(~/.config/zsh/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.config/pi/agent/auth.json)",
      "Edit(~/.config/onedrive/**)",
      "Edit(~/.gpg/**)",
      "Edit(~/.config/git/credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.kube/config)",
      "Edit(~/.password-store/**)",
      "Edit(~/dotfiles/.bashrc)",
      "Edit(~/dotfiles/.bash_profile)",
      "Edit(~/dotfiles/.zshenv)",
      "Edit(~/dotfiles/.config/zsh/**)",
      "Edit(~/.config/sandbox/**)",
      "Edit(~/dotfiles/.config/sandbox/**)",
      "Edit(~/.config/git/hooks/**)",
      "Edit(~/dotfiles/.config/git/hooks/**)",
      "Edit(~/.local/scripts/**)",
      "Edit(~/dotfiles/.local/scripts/**)",
      "Edit(~/dotfiles/.local/share/gnupg/gpg-agent.conf)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/dotfiles/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/dotfiles/.claude/settings.json)",
      "Edit(~/.config/pi/agent/extensions/**)",
      "Edit(~/dotfiles/.config/pi/agent/extensions/**)",
      "Edit(~/.config/pi/agent/settings.json)",
      "Edit(~/dotfiles/.config/pi/agent/settings.json)",
      "Edit(~/.agents/guardrails/**)",
      "Edit(~/dotfiles/.agents/guardrails/**)",
      "Edit(~/.local/share/claude/**)",
      "Edit(~/.local/share/bun/bin/**)",
      "Edit(~/.local/share/cargo/bin/**)",
      "Edit(~/.local/share/go/bin/**)",
      "Edit(~/.local/share/pkgit/kitty/HEAD/kitty/launcher/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.git-credential-cache/**)",
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] || exit 0; out=$(\"$f\" 2>&1 >/dev/null); [ -n \"$out\" ] && printf '%s\\n' \"$out\"; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|WebFetch|Glob|Grep|Skill|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/guardrails.ts\"; if [ -f \"$f\" ] && bun \"$f\"; then exit 0; fi; printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"guardrail hook failed to run (missing bun, or policy JSON missing/malformed) — denied, fail closed; see stderr\"}}'"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.agents/skills/plan-interview/SKILL.md\"; command -v jq >/dev/null || exit 0; { [ -s \"$f\" ] && cat \"$f\" || printf '%s' 'Load the plan-interview skill and follow its Question Shape before asking.'; } | jq -Rs '{hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:(\"plan-interview skill (follow its Question Shape):\\n\"+.)}}'; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.local/scripts/agent-checkpoint\"; [ -x \"$f\" ] || { printf 'agent-checkpoint is missing or not executable at %s; the allow tier depends on it. Run: make link\\n' \"$f\" >&2; exit 2; }; out=$(\"$f\" 2>&1 >/dev/null); rc=$?; [ -n \"$out\" ] && printf '%s\\n' \"$out\" >&2; [ \"$rc\" -eq 0 ] || exit 2; exit 0"
          }
        ]
      }
    ]
  },
  "disableAgentView": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "proxy.golang.org",
        "sum.golang.org"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.claude/backups",
        "~/.claude/bridge-spawn",
        "~/.claude/cache",
        "~/.claude/daemon",
        "~/.claude/daemon.lock",
        "~/.claude/daemon.status.json",
        "~/.claude/debug",
        "~/.claude/file-history",
        "~/.claude/history.jsonl",
        "~/.claude/jobs",
        "~/.claude/mcp-needs-auth-cache.json",
        "~/.claude/paste-cache",
        "~/.claude/plans",
        "~/.claude/plugins",
        "~/.claude/projects",
        "~/.claude/session-env",
        "~/.claude/sessions",
        "~/.claude/shell-snapshots",
        "~/.claude/statsig",
        "~/.claude/todos",
        "~/.local/share",
        "~/.local/state/claude",
        "~/.local/state/headroom",
        "~/.local/state/nvim",
        "~/Dropbox/org/agents",
        "~/org/agents"
      ],
      "denyWrite": [
        "~/.claude/hooks",
        "~/.local/share/bun/bin",
        "~/.local/share/cargo/bin",
        "~/.local/share/claude",
        "~/.local/share/go/bin",
        "~/.local/share/pkgit/kitty/HEAD/kitty/launcher",
        "~/dotfiles/.agents/guardrails",
        "~/dotfiles/.bash_profile",
        "~/dotfiles/.bashrc",
        "~/dotfiles/.claude/hooks",
        "~/dotfiles/.config/git/hooks",
        "~/dotfiles/.config/pi/agent/extensions",
        "~/dotfiles/.config/pi/agent/settings.json",
        "~/dotfiles/.config/sandbox",
        "~/dotfiles/.config/zsh",
        "~/dotfiles/.local/scripts",
        "~/dotfiles/.local/share/gnupg/gpg-agent.conf",
        "~/dotfiles/.zshenv"
      ],
      "denyRead": [
        "~/**/.env",
        "~/**/.env.*",
        "~/.aws",
        "~/.claude/.credentials.json",
        "~/.config/git/credentials",
        "~/.config/onedrive",
        "~/.config/pi/agent/auth.json",
        "~/.docker/config.json",
        "~/.git-credential-cache",
        "~/.git-credentials",
        "~/.gnupg",
        "~/.gpg",
        "~/.kube/config",
        "~/.lesshst",
        "~/.local/share/gnupg",
        "~/.local/share/keyrings",
        "~/.local/share/mail",
        "~/.local/share/pass",
        "~/.local/share/password-store",
        "~/.local/share/zsh",
        "~/.mozilla",
        "~/.netrc",
        "~/.npmrc",
        "~/.password-store",
        "~/.ssh",
        "~/.viminfo",
        "~/.zsh_history",
        "~/Dropbox/.dropbox",
        "~/Dropbox/.dropbox.cache"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "diffTool": "auto"
}
