#!/usr/bin/env bash
# pi / pi-acp — launch the Pi host process, with Bash sandboxed separately.
#
# Deployed under BOTH names (pi-acp is a symlink to this file) and dispatches on
# the name it was invoked as. Pi itself must stay outside the tool sandbox so its
# login, configuration, extensions, and self-update behave like Claude's host
# process. ~/.config/pi/agent/settings.json points both model Bash and !/!!
# commands at ~/.local/scripts/pi-bash, which applies the OS boundary.
set -euo pipefail

# Resolve the real binary absolutely: this shim shadows `pi` on PATH. Export the
# same Bun root so Pi's package manager recognizes the installation it came from.
self=${0##*/}
: "${BUN_INSTALL:=${XDG_DATA_HOME:-$HOME/.local/share}/bun}"
export BUN_INSTALL
real="$BUN_INSTALL/bin/$self"
[ -x "$real" ] || {
	printf '%s: the real binary is not executable at %s\n' "$self" "$real" >&2
	exit 127
}

# A Pi invoked from a sandboxed Bash command inherits that boundary. Do not nest
# bubblewrap, and do not try to read the password store hidden inside it.
if [ -n "${SANDBOX_ENGINE:-}" ] || [ -n "${SANDBOX_RUNTIME:-}" ]; then
	exec "$real" "$@"
fi

# Resolve the MCP key outside the Bash boundary. Every diagnostic stays on
# stderr because pi-acp speaks JSON-RPC on stdout.
ASTA_MCP_API_KEY=$(pass show asta-mcp) || {
	printf '%s: could not read asta-mcp from pass\n' "$self" >&2
	exit 1
}
export ASTA_MCP_API_KEY

exec "$real" "$@"
